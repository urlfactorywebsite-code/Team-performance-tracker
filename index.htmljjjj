function handleClear() {
  TEAMS.forEach(t => {
    const input = document.getElementById(`entry_team_${t.id}`);
    const revokeInput = document.getElementById(`revoke_team_${t.id}`);
    if (input) input.value = "0";
    if (revokeInput) revokeInput.value = "0";
  });
  ENTRY_USERS.forEach(u => {
    const input = document.getElementById(`entry_user_${u.id}`);
    const revokeInput = document.getElementById(`revoke_user_${u.id}`);
    if (input) input.value = "0";
    if (revokeInput) revokeInput.value = "0";
  });
}

function showStatus() {
  const status = document.getElementById("statusMsg");
  status.classList.add("show");
  setTimeout(() => status.classList.remove("show"), 1500);
}

async function handleMonthChange() {
  const monthKey = document.getElementById("monthSelect").value;
  document.getElementById("loadingMsg").style.display = "inline";
  if (!allData[monthKey]) await loadMonthData(monthKey);
  document.getElementById("loadingMsg").style.display = "none";

  const dateInput = document.getElementById("entryDate");
  if (!dateInput.value || monthKeyFromDate(dateInput.value) !== monthKey) {
    const today = todayISO();
    dateInput.value = monthKeyFromDate(today) === monthKey ? today : firstDateOfMonth(monthKey);
  }
  refreshDateDisplays();

  loadEntryFieldsForDate();
  renderAll();
}

async function moveMonth(offset) {
  const current = document.getElementById("monthSelect").value;
  const next = addMonths(current, offset);
  ensureMonthOption(next);
  document.getElementById("monthSelect").value = next;
  await handleMonthChange();
}

async function jumpToCurrentMonth() {
  const current = monthKeyFromDate(todayISO());
  ensureMonthOption(current);
  document.getElementById("monthSelect").value = current;
  await handleMonthChange();
}

async function moveSelectedDate(days) {
  const current = document.getElementById("entryDate").value || todayISO();
  const [year, month, day] = current.split("-").map(Number);
  const next = new Date(year, month - 1, day + days);
  const nextDate = `${next.getFullYear()}-${pad(next.getMonth() + 1)}-${pad(next.getDate())}`;
  document.getElementById("entryDate").value = nextDate;
  refreshDateDisplays();
  await handleDateChange();
  const selected = document.querySelector(".calendar-day.selected");
  if (selected) selected.focus({ preventScroll: true });
}

function handleCalendarKeyDown(e) {
  if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(e.key)) return;
  e.preventDefault();
  const moves = {
    ArrowLeft: -1,
    ArrowRight: 1,
    ArrowUp: -7,
    ArrowDown: 7
  };
  moveSelectedDate(moves[e.key]);
}

function toggleEditMode() {
  if (!isOwner()) return;
  editMode = !editMode;
  if (!editMode && currentView !== "home") {
    showHomeView();
    return;
  }
  updateModeUI();
  buildEntryTable();
  loadEntryFieldsForDate();
  renderAll();
}

async function handleDateChange() {
  const dateStr = document.getElementById("entryDate").value;
  if (!dateStr) return;

  const monthKey = monthKeyFromDate(dateStr);
  const monthSelect = document.getElementById("monthSelect");
  ensureMonthOption(monthKey);
  if (monthSelect.value !== monthKey) {
    monthSelect.value = monthKey;
    document.getElementById("loadingMsg").style.display = "inline";
    if (!allData[monthKey]) await loadMonthData(monthKey);
    document.getElementById("loadingMsg").style.display = "none";
  }
  refreshDateDisplays();

  loadEntryFieldsForDate();
  renderAll();
}

async function handleLogin() {
  document.getElementById("loginError").textContent = "";
  try {
    const data = await apiRequest("login", {
      method: "POST",
      body: {
        username: document.getElementById("loginUsername").value,
        password: document.getElementById("loginPassword").value
      }
    });
    await showApp(data.user);
  } catch (e) {
    document.getElementById("loginError").textContent = e.message || "Login failed";
  }
}

async function handleLogout() {
  try {
    await apiRequest("logout", { method: "POST" });
  } catch (e) {
    console.error(e);
  }
  showLogin();
}

async function refreshAfterTeamChange() {
  await loadTeams();
  buildEntryTable();
  buildUserSelects();
  const monthKey = document.getElementById("monthSelect").value;
  await loadMonthData(monthKey);
  loadEntryFieldsForDate();
  renderAll();
}

async function loadManagedTeams() {
  if (!canManageTeams()) return;
  const data = await apiRequest("teams_manage");
  renderManagedTeams(data.rows || []);
}

function renderManagedTeams(rows) {
  const list = document.getElementById("teamsList");
  if (rows.length === 0) {
    list.innerHTML = `<div class="empty-note">No teams yet.</div>`;
    return;
  }

  list.innerHTML = rows.map(team => `
    <div class="team-row" data-team-id="${escapeHTML(team.id)}">
      <input type="text" data-field="name" value="${escapeHTML(team.name)}">
      <input type="number" min="0" step="any" data-field="target" value="${Number(team.target || 0)}">
      <select data-field="metric_type">${buildSalesTypeOptions(team.metric_type || (team.unit === "leads" ? "leads" : "revenue"))}</select>
      <select data-field="currency" ${(team.metric_type || (team.unit === "leads" ? "leads" : "revenue")) === "leads" ? "disabled" : ""}>${buildCurrencyOptions(team.currency || (["USD", "INR"].includes(team.unit) ? team.unit : "USD"))}</select>
      <input type="number" step="1" data-field="position" value="${Number(team.position || 0)}">
      <select data-field="progress_mode">${buildProgressModeOptions(team.progress_mode || "monthly")}</select>
      <label class="user-active"><input type="checkbox" data-field="is_active" ${Number(team.is_active) ? "checked" : ""}> Active</label>
      <button data-team-save="${escapeHTML(team.id)}">Save</button>
    </div>
  `).join("");

  list.querySelectorAll("[data-team-save]").forEach(btn => {
    btn.addEventListener("click", () => saveExistingTeam(btn.closest(".team-row")));
  });
  list.querySelectorAll('[data-field="metric_type"]').forEach(select => {
    select.addEventListener("change", () => {
      const row = select.closest(".team-row");
      const currency = row.querySelector('[data-field="currency"]');
      currency.disabled = select.value === "leads";
    });
  });
}

function readTeamRow(row) {
  const get = field => row.querySelector(`[data-field="${field}"]`);
  return {
    id: row.dataset.teamId || "",
    name: get("name").value,
    target: get("target").value,
    metric_type: get("metric_type").value,
    currency: get("currency").value,
    position: get("position").value,
    progress_mode: get("progress_mode").value,
    is_active: get("is_active").checked
  };
}

async function saveExistingTeam(row) {
  const err = document.getElementById("teamFormError");
  err.textContent = "";
  try {
    await apiRequest("team_save", {
      method: "POST",
      body: readTeamRow(row)
    });
    await refreshAfterTeamChange();
    await loadManagedTeams();
    showStatus();
  } catch (e) {
    err.textContent = e.message || "Team could not be saved";
  }
}

async function addTeam() {
  const err = document.getElementById("teamFormError");
  err.textContent = "";
  try {
    await apiRequest("team_save", {
      method: "POST",
      body: {
        name: document.getElementById("newTeamName").value,
        target: document.getElementById("newTeamTarget").value || 0,
        metric_type: document.getElementById("newTeamMetricType").value,
        currency: document.getElementById("newTeamCurrency").value,
        position: document.getElementById("newTeamPosition").value || 0,
        progress_mode: document.getElementById("newTeamProgressMode").value,
        is_active: document.getElementById("newTeamActive").checked
      }
    });
    document.getElementById("newTeamName").value = "";
    document.getElementById("newTeamTarget").value = "";
    document.getElementById("newTeamMetricType").value = "revenue";
    document.getElementById("newTeamCurrency").value = "USD";
    document.getElementById("newTeamCurrency").disabled = false;
    document.getElementById("newTeamPosition").value = "";
    document.getElementById("newTeamProgressMode").value = "monthly";
    document.getElementById("newTeamActive").checked = true;
    await refreshAfterTeamChange();
    await loadManagedTeams();
    showStatus();
  } catch (e) {
    err.textContent = e.message || "Team could not be created";
  }
}

async function openTeams() {
  currentView = "teams";
  document.getElementById("homeContent").classList.add("hidden");
  document.getElementById("userPanel").classList.add("hidden");
  document.getElementById("teamPanel").classList.remove("hidden");
  updateModeUI();
  await loadManagedTeams();
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function closeTeams() {
  showHomeView();
}

async function loadExchangeRates() {
  if (!canManageTeams()) return;
  const err = document.getElementById("ratesFormError");
  err.textContent = "";
  try {
    const [current, history] = await Promise.all([
      apiRequest("exchange_rates_current"),
      apiRequest("exchange_rates_history")
    ]);
    const rates = current.rates || {};
    const usdInr = rates.USD_INR;
    const inrUsd = rates.INR_USD;
    document.getElementById("ratesCurrent").innerHTML = `
      <div class="detail-row"><div>USD to INR</div><strong>${usdInr ? Number(usdInr.rate).toFixed(4) : "Manual rate not set"}</strong></div>
      <div class="detail-row"><div>INR to USD</div><strong>${inrUsd ? Number(inrUsd.rate).toFixed(6) : "Manual rate not set"}</strong></div>
      <div class="detail-row"><div>Last updated</div><strong>${escapeHTML((usdInr || inrUsd || {}).fetched_at || "-")}</strong></div>
    `;
    document.getElementById("ratesHistory").innerHTML = (history.rows || []).length
      ? (history.rows || []).map(row => `
          <div class="detail-row">
            <div>${escapeHTML(row.base_currency)} to ${escapeHTML(row.target_currency)} <span>${escapeHTML(row.source || "")}</span></div>
            <strong>${Number(row.rate).toFixed(row.target_currency === "USD" ? 6 : 4)}</strong>
          </div>
        `).join("")
      : `<div class="empty-note">No exchange rate history yet.</div>`;
  } catch (e) {
    err.textContent = e.message || "Exchange rates could not be loaded";
  }
}

async function saveManualRate() {
  const err = document.getElementById("ratesFormError");
  err.textContent = "";
  try {
    await apiRequest("exchange_rates_manual", {
      method: "POST",
      body: { rate: document.getElementById("manualUsdInrRate").value }
    });
    document.getElementById("manualUsdInrRate").value = "";
    await loadExchangeRates();
    showStatus();
  } catch (e) {
    err.textContent = e.message || "Manual rate could not be saved";
  }
}

async function refreshLiveRate() {
  const err = document.getElementById("ratesFormError");
  err.textContent = "";
  try {
    await apiRequest("exchange_rates_refresh", { method: "POST", body: {} });
    await loadExchangeRates();
    showStatus();
  } catch (e) {
    err.textContent = e.message || "Live rate unavailable";
  }
}

async function openRates() {
  currentView = "rates";
  document.getElementById("homeContent").classList.add("hidden");
  document.getElementById("teamPanel").classList.add("hidden");
  document.getElementById("userPanel").classList.add("hidden");
  document.getElementById("ratesPanel").classList.remove("hidden");
  updateModeUI();
  await loadExchangeRates();
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function closeRates() {
  showHomeView();
}

async function loadUsers() {
  if (!canManageUsers()) return;
  const data = await apiRequest("users");
  renderUsers(data.rows || []);
}

function renderUsers(rows) {
  const list = document.getElementById("usersList");
  if (rows.length === 0) {
    list.innerHTML = `<div class="empty-note">No users yet.</div>`;
    return;
  }

  list.innerHTML = rows.map(user => `
    <div class="user-row" data-user-id="${user.id}">
      <input type="text" data-field="username" value="${escapeHTML(user.username)}">
      <input type="text" data-field="display_name" value="${escapeHTML(user.display_name)}">
      <select data-field="role">${buildRoleOptions(user.role)}</select>
      <input type="number" min="0" step="any" data-field="entry_target" value="${Number(user.entry_target || 0)}">
      <select data-field="currency" ${(user.sales_type || "leads") === "leads" ? "disabled" : ""}>${buildCurrencyOptions(user.currency || (["USD", "INR"].includes(user.entry_unit) ? user.entry_unit : "USD"))}</select>
      <select data-field="sales_type">${buildSalesTypeOptions(user.sales_type || (["USD", "INR"].includes(user.entry_unit) ? "revenue" : "leads"))}</select>
      <div data-field="team_ids">${buildTeamDropdown(`team_ids_${user.id}`, user.team_ids || [])}</div>
      <input type="password" data-field="password" placeholder="New password">
      <div class="user-flags">
        <label><input type="checkbox" data-field="show_dashboard_card" ${Number(user.show_dashboard_card ?? 0) ? "checked" : ""}> Show on Dashboard</label>
        <label><input type="checkbox" data-field="show_entry_list" ${Number(user.show_entry_list ?? 1) ? "checked" : ""}> Entry list</label>
        <label><input type="checkbox" data-field="is_active" ${Number(user.is_active) ? "checked" : ""}> Active</label>
      </div>
      <div class="user-active">
        <button data-user-save="${user.id}">Save</button>
      </div>
    </div>
  `).join("");

  list.querySelectorAll("[data-user-save]").forEach(btn => {
    btn.addEventListener("click", () => saveExistingUser(btn.closest(".user-row")));
  });
  list.querySelectorAll('[data-field="sales_type"]').forEach(select => {
    select.addEventListener("change", () => {
      const row = select.closest(".user-row");
      const currency = row.querySelector('[data-field="currency"]');
      currency.disabled = select.value === "leads";
    });
  });
}

function readUserRow(row) {
  const get = field => row.querySelector(`[data-field="${field}"]`);
  return {
    id: row.dataset.userId || "",
    username: get("username").value,
    display_name: get("display_name").value,
    role: get("role").value,
    entry_target: get("entry_target").value,
    currency: get("currency").value,
    sales_type: get("sales_type").value,
    team_ids: readCheckedTeams(get("team_ids")),
    password: get("password").value,
    show_dashboard_card: get("show_dashboard_card").checked,
    show_entry_list: get("show_entry_list").checked,
    is_active: get("is_active").checked
  };
}

async function saveExistingUser(row) {
  const err = document.getElementById("userFormError");
  err.textContent = "";
  try {
    await apiRequest("user_save", {
      method: "POST",
      body: readUserRow(row)
    });
    await loadEntryUsers();
    buildEntryTable();
    loadEntryFieldsForDate();
    renderAll();
    await loadUsers();
    showStatus();
  } catch (e) {
    err.textContent = e.message || "User could not be saved";
  }
}

async function addUser() {
  const err = document.getElementById("userFormError");
  err.textContent = "";
  try {
    await apiRequest("user_save", {
      method: "POST",
      body: {
        username: document.getElementById("newUsername").value,
        display_name: document.getElementById("newDisplayName").value,
        role: document.getElementById("newRole").value,
        entry_target: document.getElementById("newUserTarget").value || 0,
        currency: document.getElementById("newUserCurrency").value || "USD",
        sales_type: document.getElementById("newUserSalesType").value || "leads",
        team_ids: readCheckedTeams(document.getElementById("newTeamChecks")),
        password: document.getElementById("newPassword").value,
        show_dashboard_card: document.getElementById("newShowDashboardCard").checked,
        show_entry_list: document.getElementById("newShowEntryList").checked,
        is_active: true
      }
    });
    document.getElementById("newUsername").value = "";
    document.getElementById("newDisplayName").value = "";
    document.getElementById("newPassword").value = "";
    document.getElementById("newRole").value = "employee";
    document.getElementById("newUserTarget").value = "";
    document.getElementById("newUserCurrency").value = "USD";
    document.getElementById("newUserSalesType").value = "leads";
    document.getElementById("newShowDashboardCard").checked = false;
    document.getElementById("newShowEntryList").checked = true;
    document.getElementById("newTeamChecks").innerHTML = buildTeamDropdown("new_team_ids", []);
    await loadEntryUsers();
    buildEntryTable();
    loadEntryFieldsForDate();
    renderAll();
    await loadUsers();
    showStatus();
  } catch (e) {
    err.textContent = e.message || "User could not be created";
  }
}

async function openUsers() {
  currentView = "users";
  document.getElementById("homeContent").classList.add("hidden");
  document.getElementById("teamPanel").classList.add("hidden");
  document.getElementById("userPanel").classList.remove("hidden");
  updateModeUI();
  await loadUsers();
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function closeUsers() {
  showHomeView();
}

function showHomeView() {
  currentView = "home";
  document.getElementById("teamPanel").classList.add("hidden");
  document.getElementById("userPanel").classList.add("hidden");
  document.getElementById("ratesPanel").classList.add("hidden");
  document.getElementById("homeContent").classList.remove("hidden");
  const url = new URL(window.location.href);
  url.searchParams.delete("view");
  history.replaceState(null, "", url.toString());
  updateModeUI();
  buildEntryTable();
  loadEntryFieldsForDate();
  renderAll();
  window.scrollTo({ top: 0, behavior: "smooth" });
}

async function openManagementTab(view) {
  const url = new URL(window.location.href);
  url.searchParams.set("view", view);
  history.replaceState(null, "", url.toString());
  if (view === "teams") await openTeams();
  if (view === "users") await openUsers();
  if (view === "rates") await openRates();
}

async function openRequestedManagementView() {
  const view = new URLSearchParams(window.location.search).get("view");
  if (!isOwner() || !["teams", "users", "rates"].includes(view)) return;

  editMode = true;
  updateModeUI();
  buildEntryTable();
  loadEntryFieldsForDate();
  renderAll();

  if (view === "teams") await openTeams();
  if (view === "users") await openUsers();
  if (view === "rates") await openRates();
}

async function boot() {
  enhanceDateInputs();
  document.addEventListener("click", e => {
    if (e.target.closest(".date-field") || e.target.closest(".date-picker")) return;
    closeDatePicker();
  });
  document.addEventListener("keydown", e => {
    if (e.key === "Escape") closeDatePicker();
  });
  window.addEventListener("resize", () => {
    const picker = document.getElementById("datePicker");
    if (picker && activeDatePickerInput) positionDatePicker(activeDatePickerInput, picker);
  });
  window.addEventListener("scroll", () => {
    const picker = document.getElementById("datePicker");
    if (picker && activeDatePickerInput) positionDatePicker(activeDatePickerInput, picker);
  }, true);
  document.getElementById("loginBtn").addEventListener("click", handleLogin);
  document.getElementById("loginPassword").addEventListener("keydown", e => {
    if (e.key === "Enter") handleLogin();
  });
  document.getElementById("logoutBtn").addEventListener("click", handleLogout);
  document.getElementById("homeBtn").addEventListener("click", showHomeView);
  document.getElementById("editModeBtn").addEventListener("click", toggleEditMode);
  document.getElementById("teamsBtn").addEventListener("click", () => openManagementTab("teams"));
  document.getElementById("closeTeamsBtn").addEventListener("click", closeTeams);
  document.getElementById("addTeamBtn").addEventListener("click", addTeam);
  document.getElementById("ratesBtn").addEventListener("click", () => openManagementTab("rates"));
  document.getElementById("closeRatesBtn").addEventListener("click", closeRates);
  document.getElementById("manualRateBtn").addEventListener("click", saveManualRate);
  document.getElementById("refreshRateBtn").addEventListener("click", refreshLiveRate);
  document.getElementById("usersBtn").addEventListener("click", () => openManagementTab("users"));
  document.getElementById("closeUsersBtn").addEventListener("click", closeUsers);
  document.getElementById("addUserBtn").addEventListener("click", addUser);
  document.getElementById("quickTeamBtn").addEventListener("click", () => openManagementTab("teams"));
  document.getElementById("quickUserBtn").addEventListener("click", () => openManagementTab("users"));
  document.getElementById("monthSelect").addEventListener("change", handleMonthChange);
  document.getElementById("calendarGrid").addEventListener("keydown", handleCalendarKeyDown);
  document.getElementById("entryDate").addEventListener("change", handleDateChange);
  document.getElementById("sidebarDate").addEventListener("change", e => {
    document.getElementById("entryDate").value = e.target.value;
    handleDateChange();
  });
  document.getElementById("closeDayModalBtn").addEventListener("click", closeDayPopup);
  document.getElementById("dayModal").addEventListener("click", e => {
    if (e.target.id === "dayModal") closeDayPopup();
  });
  document.getElementById("closeCardModalBtn").addEventListener("click", closeCardPopup);
  document.getElementById("cardModal").addEventListener("click", e => {
    if (e.target.id === "cardModal") closeCardPopup();
  });
  bindMetricCurrencyToggle("newTeamMetricType", "newTeamCurrency");
  bindMetricCurrencyToggle("newUserSalesType", "newUserCurrency");
  document.getElementById("saveBtn").addEventListener("click", handleSave);
  document.getElementById("clearBtn").addEventListener("click", handleClear);

  try {
    const data = await apiRequest("me");
    if (data.authenticated && data.user) {
      await showApp(data.user);
    } else {
      showLogin();
    }
  } catch (e) {
    document.getElementById("loginError").textContent = e.message || "Server unavailable";
    showLogin();
  }
}

boot();
</script>

</body>
</html>
