<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Team Performance Tracker</title>
<style>
  :root {
    --bg: #101216;
    --panel: #181b21;
    --panel2: #20242c;
    --panel3: #252a34;
    --border: #303642;
    --text: #f0f2f5;
    --muted: #a6afbd;
    --accent: #4f8cff;
    --green: #35c26a;
    --amber: #e0a72e;
    --red: #e05a4e;
    --shadow: 0 14px 36px rgba(0,0,0,0.28);
  }
  * { box-sizing: border-box; }
  html {
    width: 100%;
    min-width: 0;
    overflow-x: hidden;
  }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    background:
      linear-gradient(rgba(16, 18, 22, 0.88), rgba(16, 18, 22, 0.92)),
      url("assets/background.png") center / cover fixed no-repeat,
      var(--bg);
    color: var(--text);
    padding: 4px clamp(4px, 1.4vw, 32px) clamp(4px, 1.4vw, 32px);
    width: 100%;
    min-width: 0;
    overflow-x: hidden;
  }
  .app-shell {
    width: 100%;
    max-width: none;
    margin: 0 auto;
    min-width: 0;
  }
  h1 {
    font-size: clamp(18px, 1.35rem, 28px);
    margin: 0 0 4px 0;
    overflow-wrap: anywhere;
  }
  .hidden { display: none !important; }
  .sub {
    color: var(--muted);
    font-size: clamp(11px, 0.82rem, 15px);
    margin-bottom: 20px;
    overflow-wrap: anywhere;
  }
  .app-header {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: flex-start;
    flex-wrap: wrap;
    padding: 10px 14px 12px;
    border: 1px solid rgba(96, 165, 250, 0.22);
    background:
      linear-gradient(90deg, rgba(16, 18, 22, 0.54), rgba(16, 18, 22, 0.78)),
      url("assets/background.png") center 20% / cover no-repeat,
      var(--panel);
    border-radius: 8px;
    margin-bottom: 12px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24);
  }
  .app-header h1,
  .app-header .sub,
  .app-header #currentUserName {
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.72);
  }
  .user-bar {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    min-width: 0;
  }
  .role-pill {
    border: 1px solid var(--border);
    background: var(--panel2);
    color: var(--muted);
    border-radius: 999px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .top-bar {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 12px;
    flex-wrap: wrap;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px;
    min-width: 0;
  }
  .top-bar > label {
    flex: 0 0 auto;
  }
  .top-bar select,
  .top-bar input,
  .top-bar .date-field {
    flex: 1 1 150px;
    max-width: 260px;
  }
  .top-bar input.date-native {
    flex: 0 0 auto;
  }
  label {
    font-size: 13px;
    color: var(--muted);
  }
  select,
  input[type=date],
  input[type=text],
  input[type=password],
  input[type=number] {
    background: var(--panel2);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 14px;
    min-width: 0;
    max-width: 100%;
  }
  select {
    color-scheme: dark;
  }
  select option,
  select optgroup {
    background: #20242c;
    color: var(--text);
  }
  select option:checked {
    background: #2f4f91;
    color: #fff;
  }
  input:disabled,
  select:disabled {
    opacity: 0.68;
    cursor: not-allowed;
  }
  input.date-native {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .date-field {
    position: relative;
    min-width: 0;
  }
  .date-trigger {
    width: 100%;
    min-height: 38px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, rgba(35, 42, 56, 0.96), rgba(20, 24, 33, 0.96));
    border: 1px solid rgba(96, 165, 250, 0.32);
    color: var(--text);
    padding: 8px 10px;
    border-radius: 8px;
    text-align: left;
    font-weight: 600;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04) inset;
  }
  .date-trigger:hover,
  .date-trigger.active {
    border-color: #facc15;
    box-shadow: 0 0 0 1px rgba(250, 204, 21, 0.2) inset;
  }
  .date-trigger span:first-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .date-trigger-icon {
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    flex: 0 0 auto;
  }
  .date-picker {
    position: fixed;
    z-index: 50;
    width: min(300px, calc(100vw - 12px));
    max-height: calc(100svh - 12px);
    overflow: auto;
    padding: 12px;
    background: linear-gradient(180deg, rgba(32, 36, 44, 0.98), rgba(24, 27, 33, 0.98));
    border: 1px solid rgba(96, 165, 250, 0.5);
    border-radius: 8px;
    box-shadow: var(--shadow), 0 0 28px rgba(79, 140, 255, 0.16);
  }
  .date-picker-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .date-picker-title {
    font-size: 13px;
    font-weight: 800;
    color: var(--text);
  }
  .date-picker-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 86px;
    gap: 6px;
    flex: 1 1 auto;
  }
  .date-picker-controls select {
    width: 100%;
    padding: 6px 8px;
    border-radius: 6px;
    font-size: 12px;
    background: #20242c;
    border-color: rgba(96, 165, 250, 0.35);
    color: var(--text);
  }
  .date-picker-nav {
    display: flex;
    gap: 6px;
  }
  .date-picker-nav button,
  .date-picker-day,
  .date-picker-footer button {
    padding: 6px 8px;
    border-radius: 6px;
    font-size: 12px;
  }
  .date-picker-nav button {
    min-width: 32px;
    background: var(--panel2);
    border: 1px solid var(--border);
    color: var(--text);
  }
  .date-picker-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 4px;
  }
  .date-picker-weekday {
    color: var(--muted);
    font-size: 11px;
    font-weight: 800;
    text-align: center;
    padding: 3px 0;
  }
  .date-picker-day {
    min-height: 32px;
    background: var(--panel2);
    border: 1px solid transparent;
    color: var(--text);
    text-align: center;
  }
  .date-picker-day:hover {
    border-color: var(--accent);
  }
  .date-picker-day.muted {
    color: #697386;
  }
  .date-picker-day.today {
    color: #d7e6ff;
    border-color: rgba(79, 140, 255, 0.55);
  }
  .date-picker-day.selected {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .date-picker-day:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .date-picker-footer {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: 10px;
  }
  .date-picker-footer button {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted);
  }
  .auth-shell {
    position: fixed;
    inset: 0;
    width: 100%;
    min-height: 100svh;
    margin: 0;
    display: grid;
    place-items: center;
    padding: clamp(4px, 2vw, 24px);
    overflow: auto;
    background:
      radial-gradient(circle at center, rgba(79, 140, 255, 0.12), transparent 34%),
      linear-gradient(90deg, rgba(16, 18, 22, 0.45), rgba(16, 18, 22, 0.78) 38%, rgba(16, 18, 22, 0.72) 62%, rgba(16, 18, 22, 0.42)),
      url("assets/team-tracker-login-background.png") center / cover no-repeat,
      var(--bg);
  }
  .auth-panel,
  .management-panel,
  .calendar-panel,
  .card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .auth-panel {
    width: min(420px, 100%);
    position: relative;
    padding: clamp(16px, 2.2vw, 28px);
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(32, 36, 44, 0.88), rgba(24, 27, 33, 0.82));
    border-color: rgba(96, 165, 250, 0.45);
    box-shadow:
      0 24px 80px rgba(0, 0, 0, 0.44),
      0 0 0 1px rgba(255, 255, 255, 0.04) inset,
      0 0 32px rgba(79, 140, 255, 0.14);
    backdrop-filter: blur(14px);
  }
  .auth-panel::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--accent), #35c26a, transparent);
  }
  .auth-panel h1 {
    font-size: clamp(20px, 1.6rem, 30px);
    margin-bottom: 6px;
  }
  .auth-panel .sub {
    margin-bottom: 22px;
  }
  .auth-panel label {
    display: block;
    font-weight: 700;
    color: #d7e6ff;
  }
  .auth-panel input {
    width: 100%;
    margin: 7px 0 14px;
    background: rgba(16, 18, 22, 0.68);
    border-color: rgba(166, 175, 189, 0.28);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04) inset;
  }
  .auth-panel input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow:
      0 0 0 3px rgba(79, 140, 255, 0.18),
      0 1px 0 rgba(255, 255, 255, 0.05) inset;
  }
  .auth-panel button {
    width: 100%;
    margin-top: 4px;
    padding-block: 11px;
    background: linear-gradient(135deg, #3f7fff, #35c26a);
    box-shadow: 0 12px 28px rgba(79, 140, 255, 0.22);
  }
  .auth-error,
  .form-error {
    color: var(--red);
    font-size: 13px;
    min-height: 18px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(8px, 1vw, 18px);
    margin-bottom: 24px;
    min-width: 0;
  }
  .card {
    padding: clamp(10px, 1vw, 18px);
    position: relative;
    overflow: hidden;
    cursor: pointer;
    border-width: 1px;
    border-color: color-mix(in srgb, var(--status-color, var(--accent)) 80%, var(--border));
    min-width: 0;
    isolation: isolate;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--status-color, var(--accent)) 10%, rgba(28, 34, 46, 0.98)), rgba(17, 20, 27, 0.98) 54%, rgba(28, 32, 43, 0.96));
    box-shadow:
      0 16px 36px rgba(0, 0, 0, 0.34),
      0 0 0 1px rgba(255, 255, 255, 0.035) inset;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 2px;
    background:
      conic-gradient(from var(--edge-angle, 0deg),
        transparent 0deg 58deg,
        var(--status-color, var(--accent)) 62deg 88deg,
        transparent 92deg 180deg,
        var(--card-edge-2, var(--status-color, var(--accent))) 186deg 210deg,
        transparent 214deg 360deg);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.96;
    pointer-events: none;
    animation: edgeRun 7s linear infinite;
    z-index: 1;
  }
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      linear-gradient(115deg, transparent 0 36%, rgba(255, 255, 255, 0.045) 37%, transparent 39% 100%),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.02) 0 1px, transparent 1px 46px);
    opacity: 0.34;
  }
  @property --edge-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }
  @keyframes edgeRun {
    to { --edge-angle: 360deg; }
  }
  @keyframes goldShine {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--status-color, var(--accent)) 76%, #fff 8%);
    box-shadow:
      0 22px 46px rgba(0, 0, 0, 0.42),
      0 0 0 1px rgba(255, 255, 255, 0.055) inset;
  }
  .card.team-card {
    --card-accent: #38bdf8;
    --card-accent-2: #22c55e;
  }
  .card.user-card {
    --card-accent: #a78bfa;
    --card-accent-2: #f472b6;
  }
  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }
  .card-badge,
  .filter-chip {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px 8px;
    font-size: 11px;
    color: var(--muted);
    background: var(--panel2);
  }
  .card-badge {
    background: color-mix(in srgb, var(--status-color, var(--accent)) 10%, rgba(32, 36, 44, 0.94));
    border-color: color-mix(in srgb, var(--status-color, var(--accent)) 38%, var(--border));
    color: #d7e6ff;
  }
  .card-badge.team { color: #dbeafe; }
  .card-badge.user { color: #e9d5ff; }
  .card-badge.status {
    color: #fff;
    border-color: color-mix(in srgb, var(--status-color, var(--accent)) 70%, var(--border));
    background: color-mix(in srgb, var(--status-color, var(--accent)) 28%, rgba(32, 36, 44, 0.86));
  }
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 14px;
  }
  .filter-panel {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 10px;
    margin: 0 0 12px;
    padding: 12px;
    background: linear-gradient(135deg, rgba(24, 27, 33, 0.96), rgba(20, 24, 32, 0.96));
    border: 1px solid rgba(96, 165, 250, 0.22);
    border-radius: 8px;
  }
  .filter-field {
    display: grid;
    gap: 5px;
  }
  .filter-field input,
  .filter-field select {
    width: 100%;
    min-width: 0;
    background: linear-gradient(135deg, rgba(35, 42, 56, 0.96), rgba(20, 24, 33, 0.96));
    border-color: rgba(96, 165, 250, 0.32);
  }
  .filter-field input:focus,
  .filter-field select:focus,
  .top-bar select:focus,
  .top-bar input:focus {
    outline: none;
    border-color: #facc15;
    box-shadow: 0 0 0 1px rgba(250, 204, 21, 0.22) inset;
  }
  .filter-chip {
    cursor: pointer;
    border-color: rgba(96, 165, 250, 0.28);
    background: linear-gradient(135deg, rgba(37, 42, 52, 0.96), rgba(25, 30, 40, 0.96));
    color: #d7e6ff;
  }
  .filter-chip.active {
    color: var(--text);
    border-color: #facc15;
    background: linear-gradient(135deg, rgba(250, 204, 21, 0.24), rgba(79, 140, 255, 0.14));
  }
  .card-topline {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: flex-start;
    min-width: 0;
  }
  .card-topline > div:first-child {
    min-width: 0;
  }
  .donut {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: conic-gradient(var(--accent) var(--pct), #2a2f39 0);
    flex: 0 0 auto;
    padding: 6px;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.06) inset;
  }
  .donut span {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(14, 17, 24, 0.96);
    display: grid;
    place-items: center;
    font-size: 10px;
    color: #f8fbff;
    font-weight: 700;
  }
  .card h3 {
    margin: 0 0 2px 0;
    font-size: 15px;
    overflow-wrap: anywhere;
    color: #fff;
  }
  .card .target {
    color: #b8c7de;
    font-size: 12px;
    margin-bottom: 10px;
    overflow-wrap: anywhere;
  }
  .bar-bg {
    background: rgba(13, 17, 24, 0.74);
    border-radius: 6px;
    height: 10px;
    overflow: hidden;
    margin-bottom: 8px;
    margin-top: 8px;
    border: 1px solid rgba(255, 255, 255, 0.04);
  }
  .bar-fill {
    height: 100%;
    border-radius: 6px;
    transition: width 0.3s ease;
  }
  .card-stats {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: var(--muted);
    gap: 10px;
    flex-wrap: wrap;
    min-width: 0;
  }
  .card-stats b {
    color: var(--text);
    font-size: 16px;
  }
  .mini-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin-top: 12px;
  }
  .mini-metric {
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--status-color, var(--accent)) 10%, rgba(36, 42, 54, 0.94)), rgba(23, 28, 38, 0.92));
    border: 1px solid color-mix(in srgb, var(--status-color, var(--accent)) 26%, var(--border));
    border-radius: 8px;
    padding: 8px;
    min-width: 0;
  }
  .mini-metric span {
    display: block;
    color: #b8c7de;
    font-size: 11px;
    margin-bottom: 4px;
  }
  .mini-metric b {
    display: block;
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    overflow-wrap: anywhere;
  }
  .sparkline {
    display: flex;
    align-items: end;
    gap: 3px;
    height: 42px;
    margin-top: 12px;
    padding: 8px;
    background:
      linear-gradient(180deg, rgba(16, 20, 28, 0.9), rgba(24, 30, 40, 0.82));
    border: 1px solid color-mix(in srgb, var(--status-color, var(--accent)) 30%, var(--border));
    border-radius: 8px;
  }
  .sparkline span {
    flex: 1;
    min-width: 3px;
    border-radius: 4px 4px 0 0;
    background: var(--accent);
    opacity: 0.95;
  }
  .pct {
    font-weight: 600;
    text-transform: lowercase;
  }
  .card.status-gold {
    background:
      linear-gradient(135deg, rgba(64, 48, 18, 0.92), rgba(18, 20, 27, 0.98) 54%, rgba(45, 35, 18, 0.94));
  }
  .card.status-gold::after {
    background:
      linear-gradient(115deg, transparent 0 32%, rgba(255, 238, 156, 0.16) 35%, transparent 38% 100%),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.024) 0 1px, transparent 1px 46px);
    background-size: 220% 100%, auto;
    animation: goldShine 2.8s ease-in-out infinite;
  }
  .quick-edit {
    margin-top: 14px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
    min-width: 0;
  }
  .quick-edit input {
    width: 100%;
    min-width: 0;
  }
  .quick-edit .quick-label {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: 12px;
  }
  .quick-edit .current-total {
    grid-column: 1 / -1;
    color: var(--text);
    font-size: 13px;
  }
  @supports not (color: color-mix(in srgb, red 50%, blue)) {
    .card {
      border-color: var(--card-accent, var(--accent));
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.34);
    }
    .card-badge,
    .mini-metric,
    .sparkline {
      border-color: var(--card-accent, var(--accent));
    }
  }
  .calendar-panel {
    position: relative;
    padding: clamp(12px, 1.2vw, 18px);
    margin-bottom: 24px;
    min-width: 0;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(22, 27, 38, 0.96), rgba(15, 18, 25, 0.98));
    border-color: rgba(96, 165, 250, 0.28);
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.28);
  }
  .calendar-panel::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, #ef4444, #facc15, #22c55e, #facc15);
    opacity: 0.9;
  }
  .calendar-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
    margin-bottom: 14px;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
  }
  .calendar-summary {
    color: #d7e6ff;
    font-size: 12px;
    border: 1px solid rgba(96, 165, 250, 0.28);
    background: rgba(32, 36, 44, 0.72);
    border-radius: 999px;
    padding: 5px 9px;
  }
  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 7px;
    min-width: 0;
    position: relative;
    z-index: 1;
  }
  .calendar-weekday {
    color: #b8c7de;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    padding: 6px 8px;
    letter-spacing: 0.6px;
    background: rgba(32, 36, 44, 0.52);
    border: 1px solid rgba(96, 165, 250, 0.12);
    border-radius: 6px;
  }
  .calendar-day {
    min-height: clamp(54px, 5vw, 112px);
    width: 100%;
    position: relative;
    background:
      linear-gradient(145deg, rgba(35, 42, 56, 0.94), rgba(21, 26, 36, 0.96));
    border: 1px solid rgba(96, 165, 250, 0.18);
    color: var(--text);
    border-radius: 8px;
    padding: 8px;
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 7px;
    cursor: pointer;
    min-width: 0;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.018);
    transition: transform 0.16s ease, border-color 0.16s ease, background 0.16s ease;
  }
  .calendar-day::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: rgba(96, 165, 250, 0.32);
    border-radius: 8px 8px 0 0;
  }
  .calendar-day:hover {
    transform: translateY(-1px);
    border-color: rgba(96, 165, 250, 0.75);
  }
  .calendar-day.good {
    border-color: rgba(34, 197, 94, 0.78);
    background: linear-gradient(145deg, rgba(20, 83, 45, 0.68), rgba(18, 39, 35, 0.94));
  }
  .calendar-day.good::before { background: #22c55e; }
  .calendar-day.mid {
    border-color: rgba(250, 204, 21, 0.78);
    background: linear-gradient(145deg, rgba(92, 72, 19, 0.68), rgba(36, 31, 24, 0.94));
  }
  .calendar-day.mid::before { background: #facc15; }
  .calendar-day.low {
    border-color: rgba(239, 68, 68, 0.78);
    background: linear-gradient(145deg, rgba(91, 30, 35, 0.68), rgba(37, 25, 31, 0.94));
  }
  .calendar-day.low::before { background: #ef4444; }
  .calendar-day.leave-day {
    border-color: #f97316;
    box-shadow: inset 0 0 0 1px rgba(249, 115, 22, 0.55);
  }
  .calendar-day.selected {
    border-color: #4f8cff;
    box-shadow: inset 0 0 0 1px #4f8cff;
  }
  .calendar-day.selected::before { background: #4f8cff; }
  .calendar-day.today .calendar-date {
    color: #111827;
    background: #facc15;
    border-color: #facc15;
  }
  .calendar-empty {
    min-height: clamp(54px, 5vw, 112px);
    border: 1px dashed rgba(96, 165, 250, 0.08);
    border-radius: 8px;
    background: rgba(16, 18, 22, 0.18);
  }
  .calendar-date {
    width: fit-content;
    min-width: 24px;
    text-align: center;
    font-size: 12px;
    color: #d7e6ff;
    font-weight: 700;
    border: 1px solid rgba(96, 165, 250, 0.22);
    border-radius: 999px;
    padding: 2px 6px;
    background: rgba(17, 24, 39, 0.68);
  }
  .calendar-revenue {
    font-size: 15px;
    font-weight: 700;
    word-break: break-word;
  }
  .calendar-values {
    display: grid;
    gap: 4px;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.15;
  }
  .calendar-values span {
    display: flex;
    justify-content: space-between;
    gap: 6px;
    padding: 3px 5px;
    border: 1px solid rgba(96, 165, 250, 0.14);
    border-radius: 5px;
    background: rgba(13, 17, 24, 0.42);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .calendar-values .unit-usd { color: #93c5fd; }
  .calendar-values .unit-inr { color: #fcd34d; }
  .calendar-values .unit-leads { color: #86efac; }
  .calendar-meta {
    font-size: 11px;
    color: #b8c7de;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border-top: 1px solid rgba(96, 165, 250, 0.12);
    padding-top: 5px;
  }
  .leave-marker {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--red);
    font-size: 11px;
    font-weight: 700;
  }
  .calendar-editor {
    margin-top: 12px;
    border-top: 1px solid var(--border);
    padding-top: 12px;
  }
  .calendar-edit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 10px;
    margin: 10px 0;
  }
  .calendar-edit-item {
    display: grid;
    gap: 5px;
  }
  .calendar-edit-item input {
    width: 100%;
  }
  .calendar-actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 8px;
  }
  .table-scroll {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    min-width: 0;
  }
  table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }
  .analytics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr));
    gap: 8px;
    margin-bottom: 12px;
  }
  .chart-panel {
    display: grid;
    gap: 8px;
    margin: 10px 0 14px;
  }
  .chart-title {
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
  }
  .svg-chart {
    width: 100%;
    height: clamp(90px, 14vh, 180px);
    background: var(--panel2);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .history-table {
    width: 100%;
    font-size: 12px;
  }
  th, td {
    padding: 10px 12px;
    text-align: left;
    font-size: 13px;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }
  th {
    background: var(--panel2);
    color: var(--muted);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.4px;
  }
  tr:last-child td { border-bottom: none; }
  input.entry {
    width: min(120px, 100%);
  }
  .entry-panel {
    position: relative;
    overflow: hidden;
    margin-top: 18px;
    padding: clamp(12px, 1.2vw, 18px);
    background: linear-gradient(135deg, rgba(22, 27, 38, 0.96), rgba(15, 18, 25, 0.98));
    border: 1px solid rgba(96, 165, 250, 0.26);
    border-radius: 8px;
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.28);
  }
  .entry-panel::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, #22c55e, #facc15, #4f8cff);
  }
  .entry-panel .section-row {
    margin: 0 0 12px;
    position: relative;
    z-index: 1;
  }
  .entry-panel .section-title {
    font-size: 17px;
    color: #fff;
  }
  .entry-table-wrap {
    border: 1px solid rgba(96, 165, 250, 0.18);
    border-radius: 8px;
    background: rgba(13, 17, 24, 0.5);
  }
  .entry-table {
    min-width: 760px;
    border: 0;
    background: transparent;
  }
  .entry-table th {
    background: linear-gradient(135deg, rgba(35, 42, 56, 0.98), rgba(22, 27, 38, 0.98));
    color: #b8c7de;
    border-bottom-color: rgba(96, 165, 250, 0.22);
    letter-spacing: 0.7px;
  }
  .entry-table td {
    background: rgba(17, 21, 30, 0.64);
    border-bottom-color: rgba(96, 165, 250, 0.12);
  }
  .entry-table tr:nth-child(even) td {
    background: rgba(23, 28, 38, 0.64);
  }
  .entry-table tr:hover td {
    background: rgba(32, 39, 53, 0.82);
  }
  .entry-table tr.entry-team td:first-child {
    border-left: 2px solid #4f8cff;
  }
  .entry-table tr.entry-user td:first-child {
    border-left: 2px solid #a78bfa;
  }
  .entry-table .unit-cell,
  .entry-table .current-cell {
    font-weight: 800;
    color: #d7e6ff;
  }
  .entry-table .action-cell {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
  .entry-table input.entry {
    width: min(140px, 100%);
    background: rgba(13, 17, 24, 0.72);
    border-color: rgba(96, 165, 250, 0.28);
    color: #fff;
    font-weight: 700;
  }
  .entry-table input.entry:focus {
    outline: none;
    border-color: #facc15;
    box-shadow: inset 0 0 0 1px rgba(250, 204, 21, 0.22);
  }
  .entry-name {
    display: grid;
    gap: 3px;
  }
  .entry-name strong {
    color: #fff;
  }
  .entry-kind {
    width: fit-content;
    color: #b8c7de;
    font-size: 11px;
    text-transform: uppercase;
    font-weight: 700;
    border: 1px solid rgba(96, 165, 250, 0.24);
    border-radius: 999px;
    padding: 2px 7px;
    background: rgba(32, 36, 44, 0.72);
  }
  .save-row {
    margin-top: 16px;
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  button {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: white;
    border: 1px solid rgba(147, 197, 253, 0.35);
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 14px;
    cursor: pointer;
    font-weight: 500;
    max-width: 100%;
    overflow-wrap: anywhere;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.22);
  }
  button:hover {
    border-color: rgba(250, 204, 21, 0.62);
    filter: brightness(1.08);
  }
  button.active {
    background: linear-gradient(135deg, #16a34a, #15803d);
    border-color: rgba(134, 239, 172, 0.5);
  }
  button.secondary {
    background: linear-gradient(135deg, rgba(37, 42, 52, 0.96), rgba(21, 27, 38, 0.96));
    border: 1px solid rgba(96, 165, 250, 0.28);
    color: var(--text);
  }
  button.danger {
    background: linear-gradient(135deg, #ef4444, #b91c1c);
    border-color: rgba(252, 165, 165, 0.55);
  }
  .status {
    font-size: 13px;
    color: var(--green);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .status.show { opacity: 1; }
  .section-title {
    font-size: 16px;
    margin: 28px 0 12px 0;
  }
  .section-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin: 28px 0 12px 0;
    flex-wrap: wrap;
  }
  .section-row .section-title {
    margin: 0;
  }
  .section-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    min-width: 0;
  }
  .dashboard-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }
  .dashboard-layout.edit-mode-active {
    grid-template-columns: minmax(0, 1fr) minmax(240px, 18vw);
  }
  .dashboard-main {
    min-width: 0;
    order: 1;
  }
  .owner-sidebar {
    order: 2;
    position: sticky;
    top: 16px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px;
    box-shadow: var(--shadow);
    display: grid;
    gap: 12px;
    min-width: 0;
  }
  .sidebar-title {
    font-size: 15px;
    font-weight: 700;
  }
  .sidebar-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .mode-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-inline: 12px;
    background: linear-gradient(135deg, rgba(37, 42, 52, 0.96), rgba(21, 27, 38, 0.96));
  }
  .mode-toggle::before {
    content: "";
    width: 34px;
    height: 18px;
    border-radius: 999px;
    background: #111827;
    border: 1px solid rgba(147, 197, 253, 0.34);
    box-shadow: inset 0 0 0 2px rgba(0, 0, 0, 0.16);
  }
  .mode-toggle::after {
    content: "";
    position: absolute;
    width: 12px;
    height: 12px;
    margin-left: 4px;
    border-radius: 999px;
    background: #94a3b8;
    transition: transform 0.18s ease, background 0.18s ease;
  }
  .mode-toggle.active::before {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.72), rgba(250, 204, 21, 0.64));
    border-color: rgba(250, 204, 21, 0.65);
  }
  .mode-toggle.active {
    background: linear-gradient(135deg, rgba(22, 163, 74, 0.28), rgba(250, 204, 21, 0.18));
  }
  .mode-toggle.active::after {
    transform: translateX(16px);
    background: #fff7c2;
  }
  .sidebar-panel {
    display: grid;
    gap: 8px;
    border-top: 1px solid var(--border);
    padding-top: 12px;
  }
  .sidebar-entry-item {
    display: grid;
    gap: 7px;
    padding: 8px;
    background: var(--panel2);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .sidebar-entry-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 7px;
  }
  .sidebar-entry-actions input,
  .owner-sidebar input,
  .owner-sidebar .date-field {
    width: 100%;
  }
  .daily-log {
    margin-top: 24px;
  }
  .daily-log .section-title {
    margin-bottom: 10px;
  }
  .day-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    background: linear-gradient(135deg, rgba(35, 42, 56, 0.94), rgba(20, 24, 33, 0.96));
    border: 1px solid rgba(96, 165, 250, 0.22);
    border-radius: 8px;
    margin-bottom: 6px;
    cursor: pointer;
    font-size: 13px;
    min-width: 0;
    gap: 12px;
  }
  .day-header span,
  .day-header-preview {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .day-header-main {
    display: grid;
    gap: 5px;
    min-width: 0;
  }
  .day-header-date {
    font-weight: 800;
    color: #fff;
  }
  .day-header-preview {
    color: #b8c7de;
    font-size: 12px;
    white-space: nowrap;
  }
  .day-header-count {
    flex: 0 0 auto;
    border: 1px solid rgba(250, 204, 21, 0.38);
    color: #fcd34d;
    border-radius: 999px;
    padding: 4px 9px;
    background: rgba(92, 72, 19, 0.22);
    font-weight: 800;
  }
  .day-body {
    display: none;
    padding: 6px 8px 14px;
    font-size: 13px;
    color: var(--muted);
  }
  .day-body.open { display: block; }
  .log-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 8px;
  }
  .log-item {
    display: grid;
    gap: 5px;
    padding: 9px 10px;
    border: 1px solid rgba(96, 165, 250, 0.18);
    border-radius: 8px;
    background: rgba(17, 21, 30, 0.72);
  }
  .log-item.add { border-left: 2px solid #22c55e; }
  .log-item.revoke { border-left: 2px solid #ef4444; }
  .log-item.snapshot { border-left: 2px solid #4f8cff; }
  .log-line {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
  }
  .log-line span {
    color: #b8c7de;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .log-line strong {
    color: #fff;
    overflow-wrap: anywhere;
    text-align: right;
  }
  .empty-note,
  .loading,
  .readonly-note {
    color: var(--muted);
    font-size: 13px;
  }
  .empty-note {
    padding: 12px;
  }
  .management-panel {
    padding: 14px;
    margin-bottom: 24px;
    box-shadow: var(--shadow);
    min-width: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .management-panel.active-view {
    display: block;
  }
  .management-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .user-form,
  .user-row,
  .team-form,
  .team-row {
    display: grid;
    grid-template-columns: repeat(10, minmax(110px, 1fr));
    gap: 8px;
    align-items: center;
    min-width: min(100%, 980px);
  }
  .user-form,
  .team-form {
    margin-bottom: 14px;
  }
  .user-row,
  .team-row {
    padding: 8px 0;
    border-top: 1px solid var(--border);
  }
  .user-form input,
  .user-form select,
  .user-row input,
  .user-row select,
  .team-form input,
  .team-row input {
    width: 100%;
    min-width: 0;
  }
  select[multiple] {
    min-height: 92px;
  }
  .team-checks {
    background: var(--panel2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px;
    min-height: 92px;
    display: grid;
    gap: 6px;
  }
  .team-checks label {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    background: var(--panel3);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 7px 8px;
    cursor: pointer;
  }
  .team-checks input {
    width: auto;
  }
  .team-checks-empty {
    color: var(--muted);
    font-size: 13px;
    align-self: center;
  }
  .team-dropdown {
    position: relative;
    background: var(--panel2);
    border: 1px solid var(--border);
    border-radius: 8px;
    min-width: 0;
  }
  .team-dropdown summary {
    cursor: pointer;
    list-style: none;
    padding: 9px 10px;
    color: var(--text);
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .team-dropdown summary::-webkit-details-marker {
    display: none;
  }
  .team-dropdown summary::after {
    content: "v";
    float: right;
    color: var(--muted);
  }
  .team-dropdown[open] summary::after {
    content: "^";
  }
  .team-dropdown .team-checks {
    border: 0;
    border-top: 1px solid var(--border);
    border-radius: 0 0 8px 8px;
    max-height: 220px;
    overflow: auto;
  }
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.58);
    display: grid;
    place-items: center;
    z-index: 20;
    padding: 16px;
  }
  .day-modal {
    width: min(900px, calc(100vw - 16px));
    max-width: 100%;
    max-height: calc(100svh - 16px);
    overflow: auto;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: var(--shadow);
    padding: 16px;
    min-width: 0;
  }
  .modal-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: flex-start;
    margin-bottom: 12px;
    min-width: 0;
  }
  .detail-list {
    display: grid;
    gap: 8px;
    min-width: 0;
  }
  .detail-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, auto);
    gap: 8px;
    padding: 9px 10px;
    border: 1px solid var(--border);
    background: var(--panel2);
    border-radius: 8px;
    font-size: 13px;
    min-width: 0;
  }
  .detail-row > * {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .detail-row span {
    color: var(--muted);
  }
  .team-form,
  .team-row {
    grid-template-columns: repeat(8, minmax(100px, 1fr));
    min-width: min(100%, 820px);
  }
  .user-active {
    display: flex;
    gap: 6px;
    align-items: center;
    color: var(--muted);
    font-size: 13px;
  }
  .user-active input {
    width: auto;
  }
  .user-flags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    align-items: center;
    color: var(--muted);
    font-size: 13px;
  }
  .user-flags label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-width: 0;
  }
  .user-flags input {
    width: auto;
  }
  @media (max-width: 900px) {
    .dashboard-layout {
      grid-template-columns: 1fr;
    }
    .owner-sidebar {
      position: static;
      order: 0;
    }
    .user-form,
    .user-row,
    .team-form,
    .team-row {
      grid-template-columns: 1fr 1fr;
      min-width: 0;
    }
  }
  @media (max-width: 720px) {
    body { padding: 14px; }
    .app-header { gap: 8px; }
    .user-bar { justify-content: flex-start; }
    .calendar-grid { gap: 4px; }
    .calendar-day {
      min-height: 64px;
      padding: 6px;
    }
    .calendar-empty { min-height: 64px; }
    .calendar-revenue { font-size: 12px; }
    .calendar-values { font-size: 11px; }
    .calendar-meta { display: none; }
    .filter-panel { grid-template-columns: 1fr; }
    th, td { padding: 9px 8px; }
    input.entry { width: 88px; }
  }
  @media (min-width: 1800px) {
    .grid {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
    .dashboard-layout.edit-mode-active {
      grid-template-columns: minmax(0, 1fr) minmax(260px, 15vw);
    }
  }
  @media (min-width: 3200px) {
    .grid {
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    }
  }
  @media (max-width: 520px) {
    .top-bar,
    .app-header,
    .user-bar,
    .section-row,
    .management-top,
    .save-row {
      align-items: stretch;
    }
    .top-bar > label {
      width: 100%;
    }
    .top-bar select,
    .top-bar input,
    .user-bar > *,
    .section-actions > *,
    .save-row > * {
      flex-basis: 100%;
      max-width: 100%;
    }
    .user-form,
    .user-row,
    .team-form,
    .team-row,
    .sidebar-entry-actions,
    .quick-edit {
      grid-template-columns: 1fr;
    }
    .calendar-weekday {
      font-size: 9px;
      padding-inline: 1px;
      text-align: center;
    }
    .calendar-day {
      padding: 4px;
      gap: 3px;
    }
    .calendar-revenue {
      font-size: 11px;
    }
    .calendar-values {
      font-size: 10px;
    }
    .modal-backdrop {
      padding: 6px;
      place-items: start center;
    }
    .day-modal {
      width: calc(100vw - 12px);
      max-height: calc(100svh - 12px);
      padding: 10px;
    }
    .auth-shell {
      place-items: center;
      background-position: center;
    }
  }
  @media (max-width: 260px) {
    body { padding: 4px; }
    h1 { font-size: 16px; }
    .sub,
    .calendar-meta,
    .card-badge.status,
    .target,
    .sparkline,
    .calendar-summary,
    .entry-kind {
      display: none;
    }
    .auth-panel,
    .top-bar,
    .filter-panel,
    .calendar-panel,
    .management-panel,
    .card {
      padding: 6px;
    }
    .auth-panel {
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.38);
      backdrop-filter: none;
    }
    .auth-panel .sub {
      display: block;
      margin-bottom: 10px;
    }
    button,
    select,
    input[type=date],
    input[type=text],
    input[type=password],
    input[type=number] {
      padding: 6px;
      font-size: 12px;
    }
    .grid,
    .mini-metrics,
    .analytics-grid {
      gap: 6px;
    }
    .card-topline {
      display: grid;
      grid-template-columns: 1fr;
    }
    .donut {
      display: none;
    }
    .mini-metrics {
      grid-template-columns: 1fr;
    }
    .calendar-grid {
      gap: 2px;
    }
    .calendar-day,
    .calendar-empty {
      min-height: 24px;
    }
    .calendar-day {
      padding: 2px;
    }
    .calendar-date {
      font-size: 10px;
    }
    .calendar-values,
    .calendar-revenue {
      display: none;
    }
    table {
      min-width: 420px;
    }
    th,
    td {
      padding: 6px;
      font-size: 11px;
    }
    .entry-panel {
      padding: 6px;
    }
    .entry-table {
      min-width: 520px;
    }
    .entry-table input.entry {
      width: 86px;
    }
  }
</style>
</head>
<body>

<div class="auth-shell hidden" id="loginView">
  <div class="auth-panel">
    <h1>Team Performance Tracker</h1>
    <div class="sub">Sign in to continue.</div>
    <label for="loginUsername">Username</label>
    <input type="text" id="loginUsername" autocomplete="username">
    <label for="loginPassword">Password</label>
    <input type="password" id="loginPassword" autocomplete="current-password">
    <button id="loginBtn">Login</button>
    <div class="auth-error" id="loginError"></div>
  </div>
</div>

<div class="app-shell hidden" id="appView">
  <div class="app-header">
    <div>
      <h1>Team Performance Tracker</h1>
      <div class="sub">Daily revenue for your active teams.</div>
    </div>
    <div class="user-bar">
      <span id="currentUserName"></span>
      <span class="role-pill" id="currentUserRole"></span>
      <button class="secondary hidden" id="homeBtn">Home</button>
      <button class="secondary hidden" id="editModeBtn">Edit Mode: Off</button>
      <button class="secondary hidden" id="teamsBtn">Teams</button>
      <button class="secondary hidden" id="usersBtn">Users</button>
      <button class="secondary hidden" id="ratesBtn">Exchange Rates</button>
      <button class="secondary" id="logoutBtn">Logout</button>
    </div>
  </div>

  <div class="top-bar">
    <label for="monthSelect">Month:</label>
    <select id="monthSelect"></select>
    <label for="entryDate">Entry date:</label>
    <input type="date" id="entryDate">
    <span class="loading" id="loadingMsg">Loading saved data...</span>
  </div>

  <div class="management-panel hidden" id="userPanel">
    <div class="management-top">
      <div class="section-title" style="margin:0;">User management</div>
      <button class="secondary" id="closeUsersBtn">Back Home</button>
    </div>
    <div class="user-form">
      <input type="text" id="newUsername" placeholder="Username">
      <input type="text" id="newDisplayName" placeholder="Display name">
      <select id="newRole"></select>
      <input type="number" min="0" step="any" id="newUserTarget" placeholder="Entry target">
      <select id="newUserCurrency"></select>
      <select id="newUserSalesType"></select>
      <div class="team-checks" id="newTeamChecks"></div>
      <input type="password" id="newPassword" placeholder="Password">
      <div class="user-flags">
        <label><input type="checkbox" id="newShowDashboardCard"> Show on Dashboard</label>
        <label><input type="checkbox" id="newShowEntryList" checked> Entry list</label>
      </div>
      <button id="addUserBtn">Add user</button>
    </div>
    <div class="form-error" id="userFormError"></div>
    <div id="usersList"></div>
  </div>

  <div class="management-panel hidden" id="teamPanel">
    <div class="management-top">
      <div class="section-title" style="margin:0;">Team management</div>
      <button class="secondary" id="closeTeamsBtn">Back Home</button>
    </div>
    <div class="team-form">
      <input type="text" id="newTeamName" placeholder="Team name">
      <input type="number" min="0" step="any" id="newTeamTarget" placeholder="Monthly target">
      <select id="newTeamMetricType"></select>
      <select id="newTeamCurrency"></select>
      <input type="number" step="1" id="newTeamPosition" placeholder="Order">
      <select id="newTeamProgressMode"></select>
      <label class="user-active"><input type="checkbox" id="newTeamActive" checked> Active</label>
      <button id="addTeamBtn">Add team</button>
    </div>
    <div class="form-error" id="teamFormError"></div>
    <div id="teamsList"></div>
  </div>

  <div class="management-panel hidden" id="ratesPanel">
    <div class="management-top">
      <div class="section-title" style="margin:0;">Exchange rates</div>
      <button class="secondary" id="closeRatesBtn">Back Home</button>
    </div>
    <div class="team-form">
      <input type="number" min="0" step="any" id="manualUsdInrRate" placeholder="USD to INR rate">
      <button id="manualRateBtn">Manual override</button>
      <button class="secondary" id="refreshRateBtn">Refresh live rate</button>
    </div>
    <div class="form-error" id="ratesFormError"></div>
    <div id="ratesCurrent" class="detail-list"></div>
    <div class="section-title">Rate history</div>
    <div id="ratesHistory" class="detail-list"></div>
  </div>

  <div class="dashboard-layout" id="homeContent">
    <aside class="owner-sidebar owner-edit-control hidden" id="ownerSidebar">
      <div class="sidebar-title">Edit controls</div>
      <div class="sidebar-actions">
        <button class="secondary" id="quickTeamBtn">+ Team</button>
        <button class="secondary" id="quickUserBtn">+ User</button>
      </div>
      <label for="sidebarDate">Selected day</label>
      <input type="date" id="sidebarDate">
      <div class="sidebar-panel" id="sidebarDaySummary"></div>
      <div class="sidebar-panel" id="sidebarEntryControls"></div>
      <div class="sidebar-panel" id="sidebarLeaveControls"></div>
    </aside>

    <main class="dashboard-main">
  <div class="filter-panel" id="dashboardFilterPanel"></div>
  <div class="filter-row" id="dashboardFilters"></div>
  <div class="grid" id="cardsGrid"></div>

  <div class="calendar-panel">
    <div class="calendar-top">
      <div class="section-title" style="margin:0;">Daily revenue calendar</div>
      <div class="calendar-summary" id="calendarSummary"></div>
    </div>
    <div class="calendar-grid" id="calendarGrid" tabindex="0" aria-label="Daily revenue calendar"></div>
  </div>

  <section class="entry-panel">
    <div class="section-row">
      <div class="section-title">Enter today's figures</div>
    </div>
    <div class="table-scroll entry-table-wrap">
      <table class="entry-table">
        <thead>
          <tr><th>Team / User</th><th>Unit</th><th>Current</th><th>Amount / Count</th><th>Revoke</th></tr>
        </thead>
        <tbody id="entryBody"></tbody>
      </table>
    </div>

    <div class="save-row" id="saveRow">
      <button id="saveBtn">Save entry</button>
      <button class="secondary" id="clearBtn">Clear fields</button>
      <span class="status" id="statusMsg">Saved OK</span>
    </div>
    <div class="readonly-note hidden" id="readonlyNote">Read-only access.</div>
  </section>

  <div class="daily-log">
    <div class="section-title">Daily log</div>
    <div id="logContainer"><div class="empty-note">No entries yet.</div></div>
  </div>
    </main>
  </div>

  <div class="modal-backdrop hidden" id="dayModal">
    <div class="day-modal">
      <div class="modal-top">
        <div>
          <div class="section-title" id="modalDateTitle" style="margin:0;"></div>
          <div class="calendar-summary" id="modalDateSummary"></div>
        </div>
        <button class="secondary" id="closeDayModalBtn">Close</button>
      </div>
      <div id="modalDayDetails"></div>
    </div>
  </div>

  <div class="modal-backdrop hidden" id="cardModal">
    <div class="day-modal">
      <div class="modal-top">
        <div>
          <div class="section-title" id="cardModalTitle" style="margin:0;"></div>
          <div class="calendar-summary" id="cardModalSummary"></div>
        </div>
        <button class="secondary" id="closeCardModalBtn">Close</button>
      </div>
      <div id="cardModalDetails"></div>
    </div>
  </div>
</div>

<script>
const ROLES = ["owner", "manager", "employee"];
const CURRENCIES = ["USD", "INR"];
const SALES_TYPES = [
  { value: "leads", label: "Leads" },
  { value: "revenue", label: "Revenue" }
];

let TEAMS = [];
let ENTRY_USERS = [];
let allData = {};
let allUserData = {};
let allAdjustments = {};
let allUserAdjustments = {};
let allLeaves = {};
let authUser = null;
let editMode = false;
let currentView = "home";
let activeDashboardFilter = "all";
let openLogDate = null;
let dashboardFilters = {
  rangeFrom: "",
  rangeTo: "",
  type: "all",
  metric: "all",
  currency: "all",
  status: "all",
  search: ""
};
let lastCardModels = [];
const DASHBOARD_FILTERS = [
  ["all", "All"],
  ["teams", "Teams only"],
  ["users", "Users only"],
  ["revenue", "Revenue only"],
  ["leads", "Leads only"],
  ["usd", "USD only"],
  ["inr", "INR only"]
];

function pad(n) { return n < 10 ? "0" + n : "" + n; }
function todayISO() {
  const d = new Date();
  return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
}
function monthKeyFromDate(dateStr) {
  return dateStr.slice(0,7);
}
function parseISODate(dateStr) {
  const parts = String(dateStr || "").split("-").map(Number);
  if (parts.length !== 3 || parts.some(part => !Number.isFinite(part))) return null;
  return new Date(parts[0], parts[1] - 1, parts[2]);
}
function dateToISO(date) {
  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
}
function formatDisplayDate(dateStr) {
  const date = parseISODate(dateStr);
  if (!date) return "dd-mm-yyyy";
  return `${pad(date.getDate())}-${pad(date.getMonth() + 1)}-${date.getFullYear()}`;
}
function monthLabel(key) {
  const [y,m] = key.split("-");
  const d = new Date(parseInt(y), parseInt(m)-1, 1);
  return d.toLocaleString('default', { month: 'long', year: 'numeric' });
}
function firstDateOfMonth(monthKey) {
  return `${monthKey}-01`;
}
function addMonths(monthKey, offset) {
  const [year, month] = monthKey.split("-").map(Number);
  const d = new Date(year, month - 1 + offset, 1);
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}`;
}
function formatRevenue(value) {
  return formatCurrencyValue(value, "USD");
}
function formatCurrencyValue(value, currency = "USD") {
  const prefix = currency === "INR" ? "\u20B9" : "$";
  return prefix + Number(value || 0).toLocaleString(undefined, {
    maximumFractionDigits: 2
  });
}
function formatUnitValue(value, unit = "USD") {
  const amount = Number(value || 0);
  if (unit === "USD") return formatRevenue(amount);
  if (unit === "INR") return formatCurrencyValue(amount, "INR");
  return `${amount.toLocaleString(undefined, { maximumFractionDigits: 2 })} ${unit}`;
}
function userSalesType(user) {
  return user && user.sales_type === "revenue" ? "revenue" : "leads";
}
function userCurrency(user) {
  return CURRENCIES.includes(user && user.currency) ? user.currency : "USD";
}
function userUnitLabel(user) {
  return userSalesType(user) === "revenue" ? userCurrency(user) : "Leads";
}
function formatUserValue(value, user) {
  if (userSalesType(user) === "revenue") return formatCurrencyValue(value, userCurrency(user));
  return formatUnitValue(value, "Leads");
}
function formatTeamValue(value, team) {
  return formatMetricValue(value, teamMetricType(team), teamCurrency(team));
}
function teamMetricType(team) {
  return team && team.metric_type === "leads" ? "leads" : "revenue";
}
function teamCurrency(team) {
  return teamMetricType(team) === "revenue" ? (CURRENCIES.includes(team && team.currency) ? team.currency : "USD") : null;
}
function teamUnitLabel(team) {
  return teamMetricType(team) === "revenue" ? teamCurrency(team) : "Leads";
}
function formatMetricValue(value, metricType, currency = "USD") {
  if (metricType === "revenue") return `${formatCurrencyValue(value, currency)} ${currency}`;
  return `${Number(value || 0).toLocaleString(undefined, { maximumFractionDigits: 0 })} leads`;
}
function safePct(value, target) {
  const t = Number(target || 0);
  if (t <= 0) return 0;
  return Math.max(0, (Number(value || 0) / t) * 100);
}
function clampPct(value) {
  return Math.max(0, Math.min(100, Number(value || 0)));
}
function roundValue(value, metricType) {
  const n = Number(value || 0);
  return metricType === "leads" ? Math.round(n) : Math.round(n * 100) / 100;
}
function statusForProgress(progress, dailyProgress = progress) {
  const p = Number(progress || 0);
  if (p >= 120) return { label: "Top performer", color: "#facc15", key: "gold" };
  if (p >= 85) return { label: p >= 100 ? "Completed" : "On target", color: "#22c55e", key: "green" };
  if (p >= 60 || dailyProgress > 0) return { label: p >= 60 ? "Slightly below" : "Warning", color: "#facc15", key: "yellow" };
  return { label: "No progress", color: "#ef4444", key: "red" };
}
function formatCalendarUnitValue(value, unit) {
  const amount = Number(value || 0).toLocaleString(undefined, { maximumFractionDigits: 2 });
  return `${unit} ${amount}`;
}
function computeCalendarUnitTotals(teamEntries = {}, userEntries = {}) {
  const totals = { USD: 0, INR: 0, Leads: 0 };
  TEAMS.forEach(team => {
    const value = teamEntries && teamEntries[team.id];
    if (typeof value === "number") {
      if (teamMetricType(team) === "leads") totals.Leads += value;
      else totals[teamCurrency(team)] += value;
    }
  });
  ENTRY_USERS.forEach(user => {
    const value = userEntries && userEntries[user.id];
    if (typeof value !== "number") return;
    if (userSalesType(user) === "revenue") totals[userCurrency(user)] += value;
    else totals.Leads += value;
  });
  return totals;
}
function renderCalendarUnitLines(totals) {
  return ["USD", "INR", "Leads"]
    .map(unit => `<span class="unit-${unit.toLowerCase()}">${escapeHTML(unit)} <b>${Number(totals[unit] || 0).toLocaleString(undefined, { maximumFractionDigits: 2 })}</b></span>`)
    .join("");
}
function calendarUnitSummaryText(totals) {
  return ["USD", "INR", "Leads"]
    .map(unit => formatCalendarUnitValue(totals[unit] || 0, unit))
    .join(" | ");
}
function dashboardEntryUsers() {
  return ENTRY_USERS.filter(user => Number(user.show_dashboard_card) === 1);
}
function listEntryUsers() {
  return ENTRY_USERS.filter(user => Number(user.show_entry_list) === 1);
}
function escapeHTML(value) {
  return String(value ?? "").replace(/[&<>"']/g, ch => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    "\"": "&quot;",
    "'": "&#039;"
  }[ch]));
}
function isOwner() {
  return authUser && authUser.role === "owner";
}
function canManageUsers() {
  return isOwner() && editMode;
}
function canManageTeams() {
  return isOwner() && editMode;
}
function canUseOwnerEditControls() {
  return isOwner() && editMode;
}
function assignedTeamIds() {
  return authUser && Array.isArray(authUser.team_ids) ? authUser.team_ids : [];
}
function canUpdateTeam(teamId) {
  if (isOwner()) return editMode;
  return assignedTeamIds().includes(teamId);
}
function canUpdateEntryUser(userId) {
  if (isOwner()) return editMode;
  return authUser && Number(authUser.id) === Number(userId);
}
function hasAnyDailyEntryAccess() {
  if (isOwner()) return true;
  return TEAMS.some(t => canUpdateTeam(t.id)) || ENTRY_USERS.some(u => canUpdateEntryUser(u.id));
}
function canSaveDailyEntries() {
  return TEAMS.some(t => canUpdateTeam(t.id)) || ENTRY_USERS.some(u => canUpdateEntryUser(u.id));
}
function teamName(teamId) {
  const team = TEAMS.find(t => t.id === teamId);
  return team ? team.name : "";
}
function entryUserName(userId) {
  const user = ENTRY_USERS.find(u => Number(u.id) === Number(userId));
  return user ? user.name : "";
}
function roleLabel(role) {
  return role.charAt(0).toUpperCase() + role.slice(1);
}

async function apiRequest(action, options = {}) {
  const params = options.params || {};
  const query = new URLSearchParams({ action, ...params });
  const request = {
    method: options.method || "GET",
    headers: options.body ? { "Content-Type": "application/json" } : undefined,
    body: options.body ? JSON.stringify(options.body) : undefined
  };
  const res = await fetch(`api.php?${query.toString()}`, request);
  let data = {};
  try {
    data = await res.json();
  } catch (e) {
    data = { error: "Invalid server response" };
  }
  if (res.status === 401 && action !== "me" && action !== "login") {
    showLogin();
  }
  if (!res.ok) {
    throw new Error(data.error || "Request failed");
  }
  return data;
}

function showLogin() {
  authUser = null;
  allData = {};
  allUserData = {};
  allAdjustments = {};
  allUserAdjustments = {};
  allLeaves = {};
  editMode = false;
  currentView = "home";
  document.getElementById("appView").classList.add("hidden");
  document.getElementById("loginView").classList.remove("hidden");
  document.getElementById("teamPanel").classList.add("hidden");
  document.getElementById("userPanel").classList.add("hidden");
  document.getElementById("ratesPanel").classList.add("hidden");
}

function updateModeUI() {
  const editBtn = document.getElementById("editModeBtn");
  const layout = document.getElementById("homeContent");
  editBtn.classList.toggle("hidden", !isOwner());
  editBtn.classList.add("mode-toggle");
  editBtn.classList.toggle("active", editMode);
  editBtn.setAttribute("aria-pressed", editMode ? "true" : "false");
  editBtn.textContent = `Edit ${editMode ? "On" : "Off"}`;
  if (layout) layout.classList.toggle("edit-mode-active", isOwner() && editMode);

  document.getElementById("homeBtn").classList.toggle("hidden", currentView === "home");
  document.getElementById("teamsBtn").classList.toggle("hidden", !canManageTeams());
  document.getElementById("usersBtn").classList.toggle("hidden", !canManageUsers());
  document.getElementById("ratesBtn").classList.toggle("hidden", !canManageTeams());
  document.querySelectorAll(".owner-edit-control").forEach(el => {
    el.classList.toggle("hidden", !canUseOwnerEditControls() || currentView !== "home");
  });

  if (!canManageTeams()) document.getElementById("teamPanel").classList.add("hidden");
  if (!canManageUsers()) document.getElementById("userPanel").classList.add("hidden");
  if (!canManageTeams()) document.getElementById("ratesPanel").classList.add("hidden");
  document.getElementById("saveRow").classList.toggle("hidden", !canSaveDailyEntries() || currentView !== "home");
  document.getElementById("readonlyNote").classList.toggle("hidden", canSaveDailyEntries() || currentView !== "home");
}

async function showApp(user) {
  authUser = user;
  editMode = false;
  currentView = "home";
  document.getElementById("loginView").classList.add("hidden");
  document.getElementById("appView").classList.remove("hidden");
  document.getElementById("currentUserName").textContent = user.display_name || user.username;
  document.getElementById("currentUserRole").textContent = roleLabel(user.role);

  await loadTeams();
  await loadEntryUsers();
  updateModeUI();
  buildMonthOptions();
  buildEntryTable();
  buildUserSelects();

  const dateInput = document.getElementById("entryDate");
  dateInput.value = todayISO();

  const monthKey = document.getElementById("monthSelect").value;
  document.getElementById("loadingMsg").style.display = "inline";
  await loadMonthData(monthKey);
  document.getElementById("loadingMsg").style.display = "none";

  loadEntryFieldsForDate();
  renderAll();
  await openRequestedManagementView();
}

function buildMonthOptions() {
  const sel = document.getElementById("monthSelect");
  sel.innerHTML = "";
  const now = new Date();
  for (let offset = -12; offset <= 6; offset++) {
    const d = new Date(now.getFullYear(), now.getMonth() + offset, 1);
    const key = `${d.getFullYear()}-${pad(d.getMonth()+1)}`;
    ensureMonthOption(key);
  }
  sel.value = monthKeyFromDate(todayISO());
}

function ensureMonthOption(monthKey) {
  const sel = document.getElementById("monthSelect");
  if ([...sel.options].some(opt => opt.value === monthKey)) return;
  const opt = document.createElement("option");
  opt.value = monthKey;
  opt.textContent = monthLabel(monthKey);
  const options = [...sel.options, opt].sort((a, b) => a.value.localeCompare(b.value));
  sel.innerHTML = "";
  options.forEach(option => sel.appendChild(option));
}

async function loadTeams() {
  const data = await apiRequest("teams");
  TEAMS = (data.rows || []).map(team => ({
    id: team.id,
    name: team.name,
    unit: team.unit || "USD",
    metric_type: team.metric_type || (team.unit === "leads" ? "leads" : "revenue"),
    currency: team.currency || (["USD", "INR"].includes(team.unit) ? team.unit : "USD"),
    progress_mode: team.progress_mode || "monthly",
    target: Number(team.target || 0),
    is_active: Number(team.is_active),
    position: Number(team.position || 0)
  }));
}

async function loadEntryUsers() {
  const data = await apiRequest("entry_users");
  ENTRY_USERS = (data.rows || []).map(user => ({
    id: Number(user.id),
    username: user.username,
    name: user.display_name || user.username,
    role: user.role,
    team_ids: Array.isArray(user.team_ids) ? user.team_ids : [],
    unit: user.unit || "leads",
    currency: user.currency || (["USD", "INR"].includes(user.unit) ? user.unit : "USD"),
    sales_type: user.sales_type || (["USD", "INR"].includes(user.unit) ? "revenue" : "leads"),
    target: Number(user.target || 0),
    show_dashboard_card: Number(user.show_dashboard_card ?? 0),
    show_entry_list: Number(user.show_entry_list ?? 1),
    is_active: Number(user.is_active)
  }));
}

function buildEntryTable() {
  const body = document.getElementById("entryBody");
  body.innerHTML = "";
  const dailyTeams = isOwner() ? TEAMS : TEAMS.filter(t => canUpdateTeam(t.id));
  const visibleUsers = listEntryUsers();
  const dailyUsers = isOwner() ? visibleUsers : visibleUsers.filter(u => canUpdateEntryUser(u.id));
  if (dailyTeams.length === 0 && dailyUsers.length === 0) {
    body.innerHTML = `<tr><td colspan="5" class="empty-note">No assigned teams or user entries.</td></tr>`;
    return;
  }
  dailyTeams.forEach(t => {
    const canUpdate = canUpdateTeam(t.id);
    const tr = document.createElement("tr");
    tr.className = "entry-team";
    tr.innerHTML = `
      <td><div class="entry-name"><strong>${escapeHTML(t.name)}</strong><span class="entry-kind">Team</span></div></td>
      <td class="unit-cell">${escapeHTML(teamUnitLabel(t))}</td>
      <td class="current-cell" id="entry_current_team_${t.id}">${formatTeamValue(0, t)}</td>
      <td><input type="number" min="0" step="any" class="entry" id="entry_team_${t.id}" value="0" placeholder="0" ${canUpdate ? "" : "disabled"}></td>
      <td class="action-cell">
        <input type="number" min="0" step="any" class="entry" id="revoke_team_${t.id}" value="0" placeholder="0" ${canUpdate ? "" : "disabled"}>
        ${canUpdate ? `<button class="danger" data-row-revoke-team="${t.id}">Revoke</button>` : ""}
      </td>
    `;
    body.appendChild(tr);
  });
  dailyUsers.forEach(u => {
    const canUpdate = canUpdateEntryUser(u.id);
    const tr = document.createElement("tr");
    tr.className = "entry-user";
    tr.innerHTML = `
      <td><div class="entry-name"><strong>${escapeHTML(u.name)}</strong><span class="entry-kind">User</span></div></td>
      <td class="unit-cell">${escapeHTML(userUnitLabel(u))}</td>
      <td class="current-cell" id="entry_current_user_${u.id}">${formatUserValue(0, u)}</td>
      <td><input type="number" min="0" step="any" class="entry" id="entry_user_${u.id}" value="0" placeholder="0" ${canUpdate ? "" : "disabled"}></td>
      <td class="action-cell">
        <input type="number" min="0" step="any" class="entry" id="revoke_user_${u.id}" value="0" placeholder="0" ${canUpdate ? "" : "disabled"}>
        ${canUpdate ? `<button class="danger" data-row-revoke-user="${u.id}">Revoke</button>` : ""}
      </td>
    `;
    body.appendChild(tr);
  });
  body.querySelectorAll("[data-row-revoke-team]").forEach(btn => {
    btn.addEventListener("click", () => handleRowRevokeTeam(btn.dataset.rowRevokeTeam));
  });
  body.querySelectorAll("[data-row-revoke-user]").forEach(btn => {
    btn.addEventListener("click", () => handleRowRevokeUser(btn.dataset.rowRevokeUser));
  });
}

function buildRoleOptions(selected = "employee") {
  return ROLES.map(role => `<option value="${role}" ${role === selected ? "selected" : ""}>${roleLabel(role)}</option>`).join("");
}

function buildCurrencyOptions(selected = "USD") {
  return CURRENCIES.map(currency => `<option value="${currency}" ${currency === selected ? "selected" : ""}>${currency}</option>`).join("");
}

function buildSalesTypeOptions(selected = "leads") {
  return SALES_TYPES.map(type => `<option value="${type.value}" ${type.value === selected ? "selected" : ""}>${type.label}</option>`).join("");
}

function buildProgressModeOptions(selected = "monthly") {
  return ["daily", "monthly"].map(mode => `<option value="${mode}" ${mode === selected ? "selected" : ""}>${mode.charAt(0).toUpperCase() + mode.slice(1)} mode</option>`).join("");
}

function buildTeamOptions(selected = []) {
  const selectedIds = Array.isArray(selected) ? selected : (selected ? [selected] : []);
  return TEAMS.map(team => (
    `<option value="${team.id}" ${selectedIds.includes(team.id) ? "selected" : ""}>${escapeHTML(team.name)}</option>`
  )).join("");
}

function buildTeamCheckboxes(name, selected = []) {
  const selectedIds = Array.isArray(selected) ? selected : (selected ? [selected] : []);
  if (TEAMS.length === 0) {
    return `<div class="team-checks-empty">No active teams</div>`;
  }
  return TEAMS.map(team => `
    <label>
      <input type="checkbox" name="${name}" value="${team.id}" ${selectedIds.includes(team.id) ? "checked" : ""}>
      <span>${escapeHTML(team.name)}</span>
    </label>
  `).join("");
}

function buildTeamDropdown(name, selected = []) {
  const selectedIds = Array.isArray(selected) ? selected : (selected ? [selected] : []);
  const count = selectedIds.length;
  const label = count ? `${count} team${count !== 1 ? "s" : ""} selected` : "Select teams";
  return `
    <details class="team-dropdown">
      <summary>${escapeHTML(label)}</summary>
      <div class="team-checks">${buildTeamCheckboxes(name, selectedIds)}</div>
    </details>
  `;
}

function readCheckedTeams(container) {
  return [...container.querySelectorAll('input[type="checkbox"]:checked')].map(input => input.value);
}

function buildUserSelects() {
  document.getElementById("newRole").innerHTML = buildRoleOptions("employee");
  document.getElementById("newUserCurrency").innerHTML = buildCurrencyOptions("USD");
  document.getElementById("newUserSalesType").innerHTML = buildSalesTypeOptions("leads");
  document.getElementById("newTeamMetricType").innerHTML = buildSalesTypeOptions("revenue");
  document.getElementById("newTeamCurrency").innerHTML = buildCurrencyOptions("USD");
  document.getElementById("newTeamProgressMode").innerHTML = buildProgressModeOptions("monthly");
  document.getElementById("newTeamChecks").innerHTML = buildTeamDropdown("new_team_ids", []);
}

function bindMetricCurrencyToggle(metricSelectId, currencySelectId) {
  const metric = document.getElementById(metricSelectId);
  const currency = document.getElementById(currencySelectId);
  if (!metric || !currency) return;
  const update = () => { currency.disabled = metric.value === "leads"; };
  metric.addEventListener("change", update);
  update();
}

async function loadMonthData(monthKey) {
  const data = await apiRequest("month", { params: { month: monthKey } });
  const monthObj = {};
  (data.rows || []).forEach(row => {
    if (!TEAMS.some(t => t.id === row.team_id)) return;
    if (!monthObj[row.entry_date]) monthObj[row.entry_date] = {};
    monthObj[row.entry_date][row.team_id] = parseFloat(row.amount);
  });
  allData[monthKey] = monthObj;
  const userMonthObj = {};
  (data.user_rows || []).forEach(row => {
    if (!ENTRY_USERS.some(u => Number(u.id) === Number(row.entry_user_id))) return;
    if (!userMonthObj[row.entry_date]) userMonthObj[row.entry_date] = {};
    userMonthObj[row.entry_date][Number(row.entry_user_id)] = parseFloat(row.amount);
  });
  allUserData[monthKey] = userMonthObj;
  allAdjustments[monthKey] = data.adjustments || [];
  allUserAdjustments[monthKey] = data.user_adjustments || [];
  const leaves = {};
  (data.leaves || []).forEach(row => {
    leaves[row.entry_date] = row;
  });
  allLeaves[monthKey] = leaves;
}

async function saveTeamEntry(teamId, dateStr, amount) {
  return apiRequest("save", {
    method: "POST",
    body: { team_id: teamId, date: dateStr, amount: amount, note: "Daily addition" }
  });
}

async function saveUserEntry(userId, dateStr, amount) {
  return apiRequest("user_entry_save", {
    method: "POST",
    body: { entry_user_id: userId, date: dateStr, amount: amount, note: "Daily addition" }
  });
}

async function revokeTeamEntry(teamId, dateStr, amount) {
  return apiRequest("revoke", {
    method: "POST",
    body: { team_id: teamId, date: dateStr, amount: amount, note: "Manual correction" }
  });
}

async function revokeUserEntry(userId, dateStr, amount) {
  return apiRequest("user_entry_revoke", {
    method: "POST",
    body: { entry_user_id: userId, date: dateStr, amount: amount, note: "Manual correction" }
  });
}

function computeMonthTotals(monthKey) {
  const totals = {};
  TEAMS.forEach(t => totals[t.id] = 0);
  const monthObj = allData[monthKey] || {};
  Object.values(monthObj).forEach(dayEntries => {
    TEAMS.forEach(t => {
      const v = dayEntries[t.id];
      if (typeof v === "number") totals[t.id] += v;
    });
  });
  return totals;
}

function computeUserMonthTotals(monthKey) {
  const totals = {};
  ENTRY_USERS.forEach(u => totals[u.id] = 0);
  const monthObj = allUserData[monthKey] || {};
  Object.values(monthObj).forEach(dayEntries => {
    ENTRY_USERS.forEach(u => {
      const v = dayEntries[u.id];
      if (typeof v === "number") totals[u.id] += v;
    });
  });
  return totals;
}

function computeDaySummary(entries) {
  let revenue = 0;
  let logged = 0;
  TEAMS.forEach(t => {
    const value = entries && entries[t.id];
    if (typeof value === "number") {
      logged++;
      revenue += value;
    }
  });
  return { revenue, logged };
}

function computeUserDaySummary(entries) {
  let count = 0;
  let logged = 0;
  ENTRY_USERS.forEach(u => {
    const value = entries && entries[u.id];
    if (typeof value === "number") {
      logged++;
      count += value;
    }
  });
  return { count, logged };
}

function getRecentDailyValues(monthKey, teamId, days = 7) {
  const monthObj = allData[monthKey] || {};
  return Object.keys(monthObj).sort().slice(-days).map(date => Number(monthObj[date][teamId] || 0));
}

function getRecentUserDailyValues(monthKey, userId, days = 7) {
  const monthObj = allUserData[monthKey] || {};
  return Object.keys(monthObj).sort().slice(-days).map(date => Number(monthObj[date][userId] || 0));
}

function optionHTML(value, label, selectedValue) {
  return `<option value="${escapeHTML(value)}" ${selectedValue === value ? "selected" : ""}>${escapeHTML(label)}</option>`;
}

function resetDashboardFilters() {
  dashboardFilters = {
    rangeFrom: "",
    rangeTo: "",
    type: "all",
    metric: "all",
    currency: "all",
    status: "all",
    search: ""
  };
  activeDashboardFilter = "all";
}

function setDashboardPreset(key) {
  activeDashboardFilter = key;
  dashboardFilters.type = "all";
  dashboardFilters.metric = "all";
  dashboardFilters.currency = "all";
  if (key === "all") return;
  if (key === "teams" || key === "users") dashboardFilters.type = key.slice(0, -1);
  if (key === "revenue" || key === "leads") dashboardFilters.metric = key;
  if (key === "usd" || key === "inr") {
    dashboardFilters.metric = "revenue";
    dashboardFilters.currency = key.toUpperCase();
  }
}

function updateDashboardFilterState(field, value) {
  dashboardFilters[field] = value;
  activeDashboardFilter = "custom";
  renderCards();
}

let activeDatePickerInput = null;
let datePickerView = null;

function refreshDateDisplays(root = document) {
  root.querySelectorAll(".date-field").forEach(field => {
    const input = field.querySelector("input.date-native");
    const label = field.querySelector("[data-date-display]");
    if (input && label) label.textContent = formatDisplayDate(input.value);
  });
}

function enhanceDateInputs(root = document) {
  root.querySelectorAll('input[type="date"]:not([data-date-enhanced])').forEach(input => {
    input.dataset.dateEnhanced = "true";
    input.classList.add("date-native");
    const field = document.createElement("div");
    field.className = "date-field";
    input.parentNode.insertBefore(field, input);
    field.appendChild(input);
    const trigger = document.createElement("button");
    trigger.type = "button";
    trigger.className = "date-trigger";
    trigger.setAttribute("aria-haspopup", "dialog");
    trigger.setAttribute("aria-label", input.id ? `Choose date for ${input.id}` : "Choose date");
    trigger.innerHTML = `<span data-date-display>${formatDisplayDate(input.value)}</span><span class="date-trigger-icon">cal</span>`;
    field.appendChild(trigger);
    trigger.addEventListener("click", event => {
      event.preventDefault();
      openDatePicker(input);
    });
    input.addEventListener("input", () => refreshDateDisplays(field));
    input.addEventListener("change", () => refreshDateDisplays(field));
  });
  refreshDateDisplays(root);
}

function closeDatePicker() {
  document.querySelectorAll(".date-trigger.active").forEach(btn => btn.classList.remove("active"));
  document.getElementById("datePicker")?.remove();
  activeDatePickerInput = null;
  datePickerView = null;
}

function setDateInputValue(input, value) {
  input.value = value;
  refreshDateDisplays(input.closest(".date-field") || document);
  input.dispatchEvent(new Event("input", { bubbles: true }));
  input.dispatchEvent(new Event("change", { bubbles: true }));
}

function clampPickerView(date, input) {
  const min = parseISODate(input.min);
  const max = parseISODate(input.max);
  if (min && date < new Date(min.getFullYear(), min.getMonth(), 1)) return new Date(min.getFullYear(), min.getMonth(), 1);
  if (max && date > new Date(max.getFullYear(), max.getMonth(), 1)) return new Date(max.getFullYear(), max.getMonth(), 1);
  return date;
}

function renderDatePicker() {
  if (!activeDatePickerInput || !datePickerView) return;
  const picker = document.getElementById("datePicker");
  if (!picker) return;
  const input = activeDatePickerInput;
  const selected = parseISODate(input.value);
  const today = parseISODate(todayISO());
  const min = parseISODate(input.min);
  const max = parseISODate(input.max);
  const year = datePickerView.getFullYear();
  const month = datePickerView.getMonth();
  const start = new Date(year, month, 1);
  const gridStart = new Date(year, month, 1 - start.getDay());
  const weekdays = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"];
  const monthOptions = Array.from({ length: 12 }, (_, index) => {
    const label = new Date(year, index, 1).toLocaleString(undefined, { month: "long" });
    return `<option value="${index}" ${index === month ? "selected" : ""}>${escapeHTML(label)}</option>`;
  }).join("");
  const minYear = min ? min.getFullYear() : year - 10;
  const maxYear = max ? max.getFullYear() : year + 10;
  const yearOptions = Array.from({ length: maxYear - minYear + 1 }, (_, index) => {
    const optionYear = minYear + index;
    return `<option value="${optionYear}" ${optionYear === year ? "selected" : ""}>${optionYear}</option>`;
  }).join("");
  const dayButtons = Array.from({ length: 42 }, (_, index) => {
    const date = new Date(gridStart.getFullYear(), gridStart.getMonth(), gridStart.getDate() + index);
    const iso = dateToISO(date);
    const disabled = (min && date < min) || (max && date > max);
    const classes = [
      "date-picker-day",
      date.getMonth() !== month ? "muted" : "",
      selected && iso === dateToISO(selected) ? "selected" : "",
      today && iso === dateToISO(today) ? "today" : ""
    ].filter(Boolean).join(" ");
    return `<button type="button" class="${classes}" data-picker-date="${iso}" ${disabled ? "disabled" : ""}>${date.getDate()}</button>`;
  }).join("");

  picker.innerHTML = `
    <div class="date-picker-top">
      <div class="date-picker-controls">
        <select data-picker-view-month aria-label="Month">${monthOptions}</select>
        <select data-picker-view-year aria-label="Year">${yearOptions}</select>
      </div>
      <div class="date-picker-nav">
        <button type="button" data-picker-month="-1" aria-label="Previous month">&lt;</button>
        <button type="button" data-picker-month="1" aria-label="Next month">&gt;</button>
      </div>
    </div>
    <div class="date-picker-grid">
      ${weekdays.map(day => `<div class="date-picker-weekday">${day}</div>`).join("")}
      ${dayButtons}
    </div>
    <div class="date-picker-footer">
      <button type="button" data-picker-clear>Clear</button>
      <button type="button" data-picker-today>Today</button>
    </div>
  `;

  picker.querySelectorAll("[data-picker-month]").forEach(btn => {
    btn.addEventListener("click", () => {
      datePickerView = clampPickerView(new Date(year, month + Number(btn.dataset.pickerMonth), 1), input);
      renderDatePicker();
    });
  });
  picker.querySelector("[data-picker-view-month]").addEventListener("change", e => {
    datePickerView = clampPickerView(new Date(year, Number(e.target.value), 1), input);
    renderDatePicker();
  });
  picker.querySelector("[data-picker-view-year]").addEventListener("change", e => {
    datePickerView = clampPickerView(new Date(Number(e.target.value), month, 1), input);
    renderDatePicker();
  });
  picker.querySelectorAll("[data-picker-date]").forEach(btn => {
    btn.addEventListener("click", () => {
      setDateInputValue(input, btn.dataset.pickerDate);
      closeDatePicker();
    });
  });
  picker.querySelector("[data-picker-clear]").addEventListener("click", () => {
    setDateInputValue(input, "");
    closeDatePicker();
  });
  picker.querySelector("[data-picker-today]").addEventListener("click", () => {
    const todayValue = todayISO();
    const todayDate = parseISODate(todayValue);
    if ((min && todayDate < min) || (max && todayDate > max)) return;
    setDateInputValue(input, todayValue);
    closeDatePicker();
  });
}

function positionDatePicker(input, picker) {
  const field = input.closest(".date-field");
  const rect = field.getBoundingClientRect();
  const width = Math.min(300, window.innerWidth - 12);
  const left = Math.max(6, Math.min(rect.left, window.innerWidth - width - 6));
  const below = rect.bottom + 6;
  const above = rect.top - picker.offsetHeight - 6;
  picker.style.width = `${width}px`;
  picker.style.left = `${left}px`;
  picker.style.top = `${below + picker.offsetHeight <= window.innerHeight - 6 ? below : Math.max(6, above)}px`;
}

function openDatePicker(input) {
  if (activeDatePickerInput === input) {
    closeDatePicker();
    return;
  }
  closeDatePicker();
  activeDatePickerInput = input;
  const baseDate = parseISODate(input.value) || parseISODate(input.min) || parseISODate(todayISO());
  datePickerView = clampPickerView(new Date(baseDate.getFullYear(), baseDate.getMonth(), 1), input);
  const picker = document.createElement("div");
  picker.id = "datePicker";
  picker.className = "date-picker";
  picker.setAttribute("role", "dialog");
  picker.setAttribute("aria-label", "Choose date");
  document.body.appendChild(picker);
  input.closest(".date-field")?.querySelector(".date-trigger")?.classList.add("active");
  renderDatePicker();
  positionDatePicker(input, picker);
}

function buildDashboardFilters() {
  const monthKey = document.getElementById("monthSelect").value || monthKeyFromDate(todayISO());
  const panel = document.getElementById("dashboardFilterPanel");
  panel.innerHTML = `
    <div class="filter-field">
      <label for="filterFromDate">From date</label>
      <input type="date" id="filterFromDate" value="${escapeHTML(dashboardFilters.rangeFrom)}">
    </div>
    <div class="filter-field">
      <label for="filterToDate">To date</label>
      <input type="date" id="filterToDate" value="${escapeHTML(dashboardFilters.rangeTo)}">
    </div>
    <div class="filter-field">
      <label for="filterType">Type</label>
      <select id="filterType">
        ${optionHTML("all", "All cards", dashboardFilters.type)}
        ${optionHTML("team", "Teams", dashboardFilters.type)}
        ${optionHTML("user", "Users", dashboardFilters.type)}
      </select>
    </div>
    <div class="filter-field">
      <label for="filterMetric">Metric</label>
      <select id="filterMetric">
        ${optionHTML("all", "All metrics", dashboardFilters.metric)}
        ${optionHTML("revenue", "Revenue", dashboardFilters.metric)}
        ${optionHTML("leads", "Leads", dashboardFilters.metric)}
      </select>
    </div>
    <div class="filter-field">
      <label for="filterCurrency">Currency</label>
      <select id="filterCurrency">
        ${optionHTML("all", "All currencies", dashboardFilters.currency)}
        ${optionHTML("USD", "USD", dashboardFilters.currency)}
        ${optionHTML("INR", "INR", dashboardFilters.currency)}
      </select>
    </div>
    <div class="filter-field">
      <label for="filterStatus">Progress</label>
      <select id="filterStatus">
        ${optionHTML("all", "All progress", dashboardFilters.status)}
        ${optionHTML("green", "On target", dashboardFilters.status)}
        ${optionHTML("yellow", "Slightly below", dashboardFilters.status)}
        ${optionHTML("red", "No progress", dashboardFilters.status)}
        ${optionHTML("gold", "Top performer", dashboardFilters.status)}
      </select>
    </div>
    <div class="filter-field">
      <label for="filterSearch">Search</label>
      <input type="text" id="filterSearch" value="${escapeHTML(dashboardFilters.search)}" placeholder="Team or user">
    </div>
    <div class="filter-field">
      <label>&nbsp;</label>
      <button type="button" class="secondary" id="clearDashboardFilters">Clear filters</button>
    </div>
  `;
  [
    ["filterFromDate", "rangeFrom"],
    ["filterToDate", "rangeTo"],
    ["filterType", "type"],
    ["filterMetric", "metric"],
    ["filterCurrency", "currency"],
    ["filterStatus", "status"],
    ["filterSearch", "search"]
  ].forEach(([id, field]) => {
    const input = document.getElementById(id);
    input.addEventListener("input", () => updateDashboardFilterState(field, input.value));
    input.addEventListener("change", () => updateDashboardFilterState(field, input.value));
  });
  enhanceDateInputs(panel);
  document.getElementById("clearDashboardFilters").addEventListener("click", () => {
    resetDashboardFilters();
    buildDashboardFilters();
    renderCards();
  });

  const container = document.getElementById("dashboardFilters");
  container.innerHTML = DASHBOARD_FILTERS.map(([key, label]) =>
    `<button type="button" class="filter-chip ${activeDashboardFilter === key ? "active" : ""}" data-dashboard-filter="${key}">${label}</button>`
  ).join("");
  container.querySelectorAll("[data-dashboard-filter]").forEach(btn => {
    btn.addEventListener("click", () => {
      setDashboardPreset(btn.dataset.dashboardFilter);
      buildDashboardFilters();
      renderCards();
    });
  });
}

function selectedDayNumber(dateStr) {
  const parts = String(dateStr || "").split("-").map(Number);
  return parts.length === 3 ? parts[2] : 1;
}

function dateForMonthDay(monthKey, day) {
  return `${monthKey}-${pad(day)}`;
}

function dayFromDateInMonth(dateStr, monthKey) {
  if (!dateStr || monthKeyFromDate(dateStr) !== monthKey) return null;
  const day = selectedDayNumber(dateStr);
  return Number.isFinite(day) ? day : null;
}

function dashboardDateRange(monthKey, dateStr, daysInMonth) {
  const selectedDay = Math.min(Math.max(selectedDayNumber(dateStr), 1), daysInMonth);
  const isCustom = !!(dashboardFilters.rangeFrom || dashboardFilters.rangeTo);
  let startDay = 1;
  let endDay = selectedDay;

  if (isCustom) {
    const [year, month] = monthKey.split("-").map(Number);
    const monthStart = new Date(year, month - 1, 1);
    const monthEnd = new Date(year, month - 1, daysInMonth);
    let from = parseISODate(dashboardFilters.rangeFrom) || monthStart;
    let to = parseISODate(dashboardFilters.rangeTo) || parseISODate(dateStr) || monthEnd;
    if (from > to) [from, to] = [to, from];
    const rangeStart = from < monthStart ? monthStart : from;
    const rangeEnd = to > monthEnd ? monthEnd : to;
    if (rangeStart <= rangeEnd) {
      startDay = rangeStart.getDate();
      endDay = rangeEnd.getDate();
    } else {
      startDay = 1;
      endDay = 0;
    }
  }

  return {
    startDay,
    endDay,
    dayCount: Math.max(0, endDay - startDay + 1),
    isCustom,
    label: isCustom ? "Range actual" : "Month-to-date actual",
    expectedLabel: isCustom ? "Expected for range" : "Expected to date"
  };
}

function assignedTeamsForUser(user, metricType, currency) {
  const ids = Array.isArray(user.team_ids) ? user.team_ids : [];
  const assigned = TEAMS.filter(team => ids.includes(team.id));
  const matching = assigned.filter(team => {
    if (teamMetricType(team) !== metricType) return false;
    return metricType === "leads" || teamCurrency(team) === currency;
  });
  return matching.length ? matching : assigned;
}

function userUsesAssignedTeamTotals(user) {
  return ["manager", "owner"].includes(user.role) && Array.isArray(user.team_ids) && user.team_ids.length > 0;
}

function userBelongsToTeam(user, teamId) {
  return Array.isArray(user.team_ids) && user.team_ids.map(String).includes(String(teamId));
}

function userMatchesTeamMetric(user, team) {
  const metricType = team.metricType || teamMetricType(team);
  const currency = metricType === "revenue" ? (team.currency || teamCurrency(team)) : null;
  if (userSalesType(user) !== metricType) return false;
  return metricType === "leads" || userCurrency(user) === currency;
}

function usersAssignedToTeamMetric(team) {
  return ENTRY_USERS.filter(user => userBelongsToTeam(user, team.id) && userMatchesTeamMetric(user, team));
}

function assignedUserValueForTeamDate(team, dateStr) {
  const userDayEntries = (allUserData[monthKeyFromDate(dateStr)] || {})[dateStr] || {};
  return usersAssignedToTeamMetric(team).reduce((sum, user) => sum + Number(userDayEntries[user.id] || 0), 0);
}

function teamTotalForDate(team, dateStr) {
  const dayEntries = (allData[monthKeyFromDate(dateStr)] || {})[dateStr] || {};
  return Number(dayEntries[team.id] || 0) + assignedUserValueForTeamDate(team, dateStr);
}

function buildSeriesForTeam(team, monthKey, daysInMonth) {
  return Array.from({ length: daysInMonth }, (_, index) => {
    const date = dateForMonthDay(monthKey, index + 1);
    return teamTotalForDate(team, date);
  });
}

function buildSeriesForUser(user, monthKey, daysInMonth, sourceTeams = []) {
  const userMonthObj = allUserData[monthKey] || {};
  if (sourceTeams.length) {
    return Array.from({ length: daysInMonth }, (_, index) => {
      const date = dateForMonthDay(monthKey, index + 1);
      return sourceTeams.reduce((sum, team) => sum + teamTotalForDate(team, date), 0);
    });
  }
  return Array.from({ length: daysInMonth }, (_, index) => Number((userMonthObj[dateForMonthDay(monthKey, index + 1)] || {})[user.id] || 0));
}

function buildCardModel(base, ownerType, monthKey, dateStr, daysInMonth) {
  const metricType = ownerType === "team" ? teamMetricType(base) : userSalesType(base);
  const currency = metricType === "revenue" ? (ownerType === "team" ? teamCurrency(base) : userCurrency(base)) : null;
  const dayNo = Math.min(Math.max(selectedDayNumber(dateStr), 1), daysInMonth);
  const range = dashboardDateRange(monthKey, dateStr, daysInMonth);
  let target = Math.max(Number(base.target || 0), 0);
  let progressMode = ownerType === "team" ? (base.progress_mode || "monthly") : "daily";
  let sourceTeams = [];

  if (ownerType === "user" && userUsesAssignedTeamTotals(base)) {
    sourceTeams = assignedTeamsForUser(base, metricType, currency);
    if (sourceTeams.length) {
      target = sourceTeams.reduce((sum, team) => sum + Number(team.target || 0), 0);
      progressMode = sourceTeams.length === 1 ? (sourceTeams[0].progress_mode || "daily") : "daily";
    }
  } else if (ownerType === "user" && Array.isArray(base.team_ids) && base.team_ids.length === 1) {
    const team = TEAMS.find(t => t.id === base.team_ids[0]);
    if (team) progressMode = team.progress_mode || "daily";
  }

  const series = ownerType === "team"
    ? buildSeriesForTeam(base, monthKey, daysInMonth)
    : buildSeriesForUser(base, monthKey, daysInMonth, sourceTeams);
  const selectedDayActual = series[dayNo - 1] || 0;
  const monthToDateActual = series.slice(range.startDay - 1, range.endDay).reduce((sum, value) => sum + Number(value || 0), 0);
  const dailyTarget = target > 0 ? target / daysInMonth : 0;
  const expectedTillDate = dailyTarget * range.dayCount;
  const variance = monthToDateActual - expectedTillDate;
  const dailyProgress = safePct(selectedDayActual, dailyTarget);
  const periodProgress = safePct(monthToDateActual, expectedTillDate);
  const monthlyProgress = range.isCustom ? periodProgress : safePct(monthToDateActual, target);
  const ringProgress = progressMode === "daily" && !range.isCustom ? dailyProgress : monthlyProgress;
  const remainingTarget = Math.max(0, target - monthToDateActual);
  const remainingDays = Math.max(0, daysInMonth - range.endDay);
  const avgPerDay = range.dayCount > 0 ? monthToDateActual / range.dayCount : 0;
  const requiredAvg = remainingDays > 0 ? remainingTarget / remainingDays : 0;
  const indexed = series.map((value, index) => ({ day: index + 1, value: Number(value || 0) }));
  const rangeIndexed = indexed.slice(range.startDay - 1, range.endDay);
  const nonZero = rangeIndexed.filter(item => item.value > 0);
  const best = nonZero.length ? nonZero.reduce((a, b) => b.value > a.value ? b : a) : { day: "-", value: 0 };
  const worst = nonZero.length ? nonZero.reduce((a, b) => b.value < a.value ? b : a) : { day: "-", value: 0 };
  const last7 = series.slice(Math.max(0, dayNo - 7), dayNo).reduce((sum, value) => sum + Number(value || 0), 0);
  const recent3 = series.slice(Math.max(0, dayNo - 3), dayNo).reduce((sum, value) => sum + Number(value || 0), 0) / 3;
  const prev3 = series.slice(Math.max(0, dayNo - 6), Math.max(0, dayNo - 3)).reduce((sum, value) => sum + Number(value || 0), 0) / 3;
  const trend = recent3 > prev3 * 1.08 ? "improving" : (recent3 < prev3 * 0.92 ? "dropping" : "stable");
  const status = statusForProgress(monthlyProgress, dailyProgress);

  return {
    key: `${ownerType}:${base.id}`,
    id: base.id,
    ownerType,
    name: base.name,
    metricType,
    currency,
    target,
    progressMode,
    sourceTeams,
    series,
    range,
    selectedDayActual,
    monthToDateActual,
    dailyTarget,
    expectedTillDate,
    variance,
    dailyProgress,
    monthlyProgress,
    ringProgress,
    remainingTarget,
    avgPerDay,
    requiredAvg,
    best,
    worst,
    last7,
    trend,
    status
  };
}

function buildCardModels(monthKey, dateStr) {
  const [year, month] = monthKey.split("-").map(Number);
  const daysInMonth = new Date(year, month, 0).getDate();
  const teamCards = TEAMS.map(team => buildCardModel(team, "team", monthKey, dateStr, daysInMonth));
  const userCards = dashboardEntryUsers().map(user => buildCardModel(user, "user", monthKey, dateStr, daysInMonth));
  return [...teamCards, ...userCards];
}

function cardPassesFilter(card) {
  const filters = dashboardFilters;
  const search = filters.search.trim().toLowerCase();
  if (filters.type !== "all" && card.ownerType !== filters.type) return false;
  if (filters.metric !== "all" && card.metricType !== filters.metric) return false;
  if (filters.currency !== "all" && card.currency !== filters.currency) return false;
  if (filters.status !== "all" && card.status.key !== filters.status) return false;
  if (search && !card.name.toLowerCase().includes(search)) return false;
  return true;
}

function renderProgressBar(label, pct, color) {
  return `
    <div class="mini-metric">
      <span>${label}</span>
      <b>${Number(pct || 0).toFixed(0)}%</b>
      <div class="bar-bg"><div class="bar-fill" style="width:${clampPct(pct)}%; background:${color};"></div></div>
    </div>
  `;
}

function cardAccentPalette(model) {
  if (model.status.key === "gold") return ["#facc15", "#fde68a"];
  if (model.status.key === "green") return ["#22c55e", "#86efac"];
  if (model.status.key === "yellow") return ["#facc15", "#f97316"];
  return ["#ef4444", "#f87171"];
}

function renderCards() {
  const monthKey = document.getElementById("monthSelect").value;
  const dateStr = document.getElementById("entryDate").value;
  const grid = document.getElementById("cardsGrid");
  grid.innerHTML = "";
  lastCardModels = buildCardModels(monthKey, dateStr);
  const visibleCards = lastCardModels.filter(cardPassesFilter);
  if (!visibleCards.length) {
    grid.innerHTML = `<div class="empty-note">No dashboard cards match this filter.</div>`;
    return;
  }
  visibleCards.forEach(model => {
    const color = model.status.color;
    const targetText = formatMetricValue(model.target, model.metricType, model.currency);
    const selectedText = formatMetricValue(model.selectedDayActual, model.metricType, model.currency);
    const mtdText = formatMetricValue(model.monthToDateActual, model.metricType, model.currency);
    const dailyTargetText = formatMetricValue(model.dailyTarget, model.metricType, model.currency);
    const expectedText = formatMetricValue(model.expectedTillDate, model.metricType, model.currency);
    const varianceText = `${model.variance >= 0 ? "+" : ""}${formatMetricValue(model.variance, model.metricType, model.currency)}`;
    const maxRecent = Math.max(...model.series.slice(-7), model.dailyTarget, 1);
    const [accent, accent2] = cardAccentPalette(model);
    const card = document.createElement("div");
    card.className = `card ${model.ownerType}-card status-${model.status.key}`;
    card.style.setProperty("--status-color", color);
    card.style.setProperty("--card-accent", accent);
    card.style.setProperty("--card-accent-2", accent2);
    card.style.setProperty("--card-edge-2", accent2);
    card.dataset.cardKey = model.key;
    card.innerHTML = `
      <div class="card-topline">
        <div>
          <h3>${escapeHTML(model.name)}</h3>
          <div class="badge-row">
            <span class="card-badge ${model.ownerType}">${model.ownerType === "team" ? "Team" : "User"}</span>
            <span class="card-badge">${model.metricType === "revenue" ? "Revenue" : "Leads"}</span>
            ${model.metricType === "revenue" ? `<span class="card-badge">${escapeHTML(model.currency)}</span>` : ""}
            <span class="card-badge status">${escapeHTML(model.status.label)}</span>
          </div>
          <div class="target">Monthly target: ${targetText}</div>
        </div>
        <div class="donut" style="--pct:${clampPct(model.ringProgress)}%; background: conic-gradient(${color} ${clampPct(model.ringProgress)}%, #2a2f39 0);"><span>${model.ringProgress.toFixed(0)}%</span></div>
      </div>
      <div class="card-stats">
        <span><b>${mtdText}</b> / ${targetText}</span>
        <span class="pct" style="color:${color}">${model.progressMode} ring</span>
      </div>
      <div class="mini-metrics">
        <div class="mini-metric"><span>Selected day</span><b>${selectedText}</b></div>
        <div class="mini-metric"><span>Daily target</span><b>${dailyTargetText}</b></div>
        <div class="mini-metric"><span>${escapeHTML(model.range.expectedLabel)}</span><b>${expectedText}</b></div>
        <div class="mini-metric"><span>Variance</span><b style="color:${model.variance >= 0 ? "var(--green)" : "var(--red)"}">${varianceText}</b></div>
        ${renderProgressBar("Daily progress", model.dailyProgress, color)}
        ${renderProgressBar("Monthly progress", model.monthlyProgress, color)}
      </div>
      <div class="sparkline" title="Recent daily performance">
        ${model.series.slice(-7).map(value => `<span style="height:${Math.max(8, (Number(value || 0) / maxRecent) * 100)}%; background:${value >= model.dailyTarget ? "var(--green)" : "var(--amber)"}"></span>`).join("")}
      </div>
    `;
    grid.appendChild(card);
  });
  grid.querySelectorAll("[data-card-key]").forEach(card => {
    card.addEventListener("click", () => openCardPopup(card.dataset.cardKey));
  });
}

function chartPolyline(values, width = 560, height = 120) {
  const max = Math.max(...values, 1);
  const step = values.length > 1 ? width / (values.length - 1) : width;
  return values.map((value, index) => {
    const x = index * step;
    const y = height - ((Number(value || 0) / max) * (height - 16)) - 8;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  }).join(" ");
}

function renderSvgChart(title, values, color = "var(--accent)") {
  const points = chartPolyline(values);
  return `
    <div class="chart-panel">
      <div class="chart-title">${escapeHTML(title)}</div>
      <svg class="svg-chart" viewBox="0 0 560 120" preserveAspectRatio="none" role="img" aria-label="${escapeHTML(title)}">
        <polyline fill="none" stroke="${color}" stroke-width="3" points="${points}"></polyline>
      </svg>
    </div>
  `;
}

function cumulativeValues(values) {
  let total = 0;
  return values.map(value => {
    total += Number(value || 0);
    return total;
  });
}

function targetValues(model) {
  let total = 0;
  return model.series.map(() => {
    total += Number(model.dailyTarget || 0);
    return total;
  });
}

function logsForCard(model) {
  const monthKey = document.getElementById("monthSelect").value;
  const inRange = item => {
    const day = dayFromDateInMonth(item.entry_date, monthKey);
    return day !== null && day >= model.range.startDay && day <= model.range.endDay;
  };
  if (model.ownerType === "team") {
    const assignedUserIds = usersAssignedToTeamMetric(model).map(user => Number(user.id));
    const teamLogs = (allAdjustments[monthKey] || [])
      .filter(item => item.team_id === model.id)
      .filter(inRange)
      .map(item => ({ ...item, subject: teamName(item.team_id), actor: item.user_name || "Unknown" }));
    const userLogs = (allUserAdjustments[monthKey] || [])
      .filter(item => assignedUserIds.includes(Number(item.entry_user_id)))
      .filter(inRange)
      .map(item => ({ ...item, subject: item.entry_user_name || entryUserName(item.entry_user_id), actor: item.actor_name || "Unknown" }));
    return [...teamLogs, ...userLogs].sort((a, b) => String(b.created_at || "").localeCompare(String(a.created_at || "")));
  }
  if (model.sourceTeams && model.sourceTeams.length) {
    const ids = model.sourceTeams.map(team => team.id);
    return (allAdjustments[monthKey] || [])
      .filter(item => ids.includes(item.team_id))
      .filter(inRange)
      .map(item => ({ ...item, subject: teamName(item.team_id), actor: item.user_name || "Unknown" }));
  }
  return (allUserAdjustments[monthKey] || [])
    .filter(item => Number(item.entry_user_id) === Number(model.id))
    .filter(inRange)
    .map(item => ({ ...item, subject: item.entry_user_name || entryUserName(item.entry_user_id), actor: item.actor_name || "Unknown" }));
}

function renderHistoryRows(model) {
  const rows = logsForCard(model).slice(0, 20);
  if (!rows.length) return `<div class="empty-note">No add/revoke history for this card.</div>`;
  return `
    <div class="table-scroll">
      <table class="history-table">
        <thead><tr><th>Date</th><th>Action</th><th>Amount</th><th>By</th><th>Subject</th></tr></thead>
        <tbody>
          ${rows.map(item => `
            <tr>
              <td>${escapeHTML(item.entry_date)}</td>
              <td>${escapeHTML(item.action)}</td>
              <td>${formatMetricValue(item.amount, model.metricType, model.currency)}</td>
              <td>${escapeHTML(item.actor)}</td>
              <td>${escapeHTML(item.subject)}</td>
            </tr>
          `).join("")}
        </tbody>
      </table>
    </div>
  `;
}

function openCardPopup(cardKey) {
  const model = lastCardModels.find(item => item.key === cardKey);
  if (!model) return;
  const modal = document.getElementById("cardModal");
  document.getElementById("cardModalTitle").textContent = model.name;
  document.getElementById("cardModalSummary").textContent =
    `${model.ownerType === "team" ? "Team" : "User"} | ${model.metricType === "revenue" ? "Revenue" : "Leads"}${model.currency ? " | " + model.currency : ""}`;
  const selectedText = formatMetricValue(model.selectedDayActual, model.metricType, model.currency);
  const mtdText = formatMetricValue(model.monthToDateActual, model.metricType, model.currency);
  const targetText = formatMetricValue(model.target, model.metricType, model.currency);
  const dailyTargetText = formatMetricValue(model.dailyTarget, model.metricType, model.currency);
  const expectedText = formatMetricValue(model.expectedTillDate, model.metricType, model.currency);
  const varianceText = `${model.variance >= 0 ? "+" : ""}${formatMetricValue(model.variance, model.metricType, model.currency)}`;
  const remainingText = formatMetricValue(model.remainingTarget, model.metricType, model.currency);
  const avgText = formatMetricValue(model.avgPerDay, model.metricType, model.currency);
  const requiredText = formatMetricValue(model.requiredAvg, model.metricType, model.currency);
  document.getElementById("cardModalDetails").innerHTML = `
    <div class="analytics-grid">
      <div class="mini-metric"><span>Monthly target</span><b>${targetText}</b></div>
      <div class="mini-metric"><span>Daily target</span><b>${dailyTargetText}</b></div>
      <div class="mini-metric"><span>Selected day actual</span><b>${selectedText}</b></div>
      <div class="mini-metric"><span>${escapeHTML(model.range.label)}</span><b>${mtdText}</b></div>
      <div class="mini-metric"><span>${escapeHTML(model.range.expectedLabel)}</span><b>${expectedText}</b></div>
      <div class="mini-metric"><span>Variance</span><b style="color:${model.variance >= 0 ? "var(--green)" : "var(--red)"}">${varianceText}</b></div>
      <div class="mini-metric"><span>Remaining target</span><b>${remainingText}</b></div>
      <div class="mini-metric"><span>Completion</span><b>${model.monthlyProgress.toFixed(1)}%</b></div>
      <div class="mini-metric"><span>Average per day so far</span><b>${avgText}</b></div>
      <div class="mini-metric"><span>Required remaining avg</span><b>${requiredText}</b></div>
      <div class="mini-metric"><span>Best day</span><b>${model.best.day}: ${formatMetricValue(model.best.value, model.metricType, model.currency)}</b></div>
      <div class="mini-metric"><span>Worst day</span><b>${model.worst.day}: ${formatMetricValue(model.worst.value, model.metricType, model.currency)}</b></div>
      <div class="mini-metric"><span>Last 7 days</span><b>${formatMetricValue(model.last7, model.metricType, model.currency)}</b></div>
      <div class="mini-metric"><span>Trend</span><b>${escapeHTML(model.trend)}</b></div>
    </div>
    ${renderSvgChart("Daily chart", model.series, model.status.color)}
    ${renderSvgChart("Cumulative monthly chart", cumulativeValues(model.series), model.status.color)}
    ${renderSvgChart("Target vs actual baseline", targetValues(model), "var(--muted)")}
    <div class="section-title">Add/Revoke history</div>
    ${renderHistoryRows(model)}
  `;
  modal.classList.remove("hidden");
}

function closeCardPopup() {
  document.getElementById("cardModal").classList.add("hidden");
}

function renderCalendar() {
  const monthKey = document.getElementById("monthSelect").value;
  const monthObj = allData[monthKey] || {};
  const userMonthObj = allUserData[monthKey] || {};
  const leaveObj = allLeaves[monthKey] || {};
  const selectedDate = document.getElementById("entryDate").value;
  const today = todayISO();
  const [year, month] = monthKey.split("-").map(Number);
  const firstDay = new Date(year, month - 1, 1);
  const daysInMonth = new Date(year, month, 0).getDate();
  const firstWeekday = firstDay.getDay();
  const dailyTarget = TEAMS.reduce((sum, team) => sum + Number(team.target || 0), 0) / daysInMonth;
  const grid = document.getElementById("calendarGrid");
  const summary = document.getElementById("calendarSummary");
  const weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
  const monthlyUnitTotals = { USD: 0, INR: 0, Leads: 0 };

  Array.from(new Set([...Object.keys(monthObj), ...Object.keys(userMonthObj)])).forEach(dateStr => {
    const unitTotals = computeCalendarUnitTotals(monthObj[dateStr] || {}, userMonthObj[dateStr] || {});
    monthlyUnitTotals.USD += unitTotals.USD;
    monthlyUnitTotals.INR += unitTotals.INR;
    monthlyUnitTotals.Leads += unitTotals.Leads;
  });

  summary.textContent = `${monthLabel(monthKey)}: ${calendarUnitSummaryText(monthlyUnitTotals)}`;
  grid.innerHTML = "";

  weekdays.forEach(day => {
    const label = document.createElement("div");
    label.className = "calendar-weekday";
    label.textContent = day;
    grid.appendChild(label);
  });

  for (let i = 0; i < firstWeekday; i++) {
    const blank = document.createElement("div");
    blank.className = "calendar-empty";
    grid.appendChild(blank);
  }

  for (let day = 1; day <= daysInMonth; day++) {
    const dateStr = `${monthKey}-${pad(day)}`;
    const entries = monthObj[dateStr] || {};
    const userEntries = userMonthObj[dateStr] || {};
    const leave = leaveObj[dateStr];
    const daySummary = computeDaySummary(entries);
    const userSummary = computeUserDaySummary(userEntries);
    const unitTotals = computeCalendarUnitTotals(entries, userEntries);
    const dayTotal = unitTotals.USD + unitTotals.INR + unitTotals.Leads;
    const ratio = dailyTarget > 0 ? ((unitTotals.USD + unitTotals.INR) / dailyTarget) : 0;
    const button = document.createElement("button");
    button.type = "button";
    button.className = "calendar-day";
    if (dayTotal > 0) {
      if (ratio >= 1) button.classList.add("good");
      else if (ratio >= 0.6) button.classList.add("mid");
      else button.classList.add("low");
    }
    if (leave) button.classList.add("leave-day");
    if (dateStr === selectedDate) button.classList.add("selected");
    if (dateStr === today) button.classList.add("today");
    button.innerHTML = `
      <span class="calendar-date">${day}</span>
      <span class="calendar-values">${renderCalendarUnitLines(unitTotals)}</span>
      <span class="calendar-meta">${leave ? `<span class="leave-marker">! Leave</span>` : ((daySummary.logged || userSummary.logged) ? `${daySummary.logged} team${daySummary.logged !== 1 ? "s" : ""}, ${userSummary.logged} user${userSummary.logged !== 1 ? "s" : ""}` : "No data")}</span>
    `;
    button.addEventListener("click", () => {
      document.getElementById("entryDate").value = dateStr;
      loadEntryFieldsForDate();
      renderAll();
      openDayPopup(dateStr);
    });
    grid.appendChild(button);
  }
}

function renderCalendarEditor() {
  const editor = document.getElementById("calendarEditor");
  if (!editor) return;
  const dateStr = document.getElementById("entryDate").value;
  const monthKey = monthKeyFromDate(dateStr);
  const dayEntries = (allData[monthKey] || {})[dateStr] || {};
  const userDayEntries = (allUserData[monthKey] || {})[dateStr] || {};
  const unitTotals = computeCalendarUnitTotals(dayEntries, userDayEntries);

  if (!canUseOwnerEditControls()) {
    editor.innerHTML = `<div class="readonly-note">${escapeHTML(dateStr)}: ${escapeHTML(calendarUnitSummaryText(unitTotals))}</div>`;
    return;
  }

  editor.innerHTML = `
    <div class="calendar-summary">${escapeHTML(dateStr)}: ${escapeHTML(calendarUnitSummaryText(unitTotals))}</div>
    <div class="calendar-edit-grid">
      ${TEAMS.map(t => `
        <div class="calendar-edit-item">
          <span>${escapeHTML(t.name)}</span>
          <span class="readonly-note">Current: ${formatTeamValue(teamTotalForDate(t, dateStr), t)}</span>
          <div class="calendar-actions">
            <input type="number" min="0" step="any" id="calendar_add_${t.id}" value="0" placeholder="Add ${escapeHTML(teamUnitLabel(t))}">
            <button data-calendar-add="${t.id}">Add</button>
            <input type="number" min="0" step="any" id="calendar_revoke_${t.id}" value="0" placeholder="Revoke ${escapeHTML(teamUnitLabel(t))}">
            <button class="danger" data-calendar-revoke="${t.id}">Revoke</button>
          </div>
        </div>
      `).join("")}
    </div>
  `;
  editor.querySelectorAll("[data-calendar-add]").forEach(btn => {
    btn.addEventListener("click", () => handleCalendarAdd(btn.dataset.calendarAdd));
  });
  editor.querySelectorAll("[data-calendar-revoke]").forEach(btn => {
    btn.addEventListener("click", () => handleCalendarRevoke(btn.dataset.calendarRevoke));
  });
}

function dayAdjustments(dateStr) {
  return (allAdjustments[monthKeyFromDate(dateStr)] || []).filter(item => item.entry_date === dateStr);
}

function userDayAdjustments(dateStr) {
  return (allUserAdjustments[monthKeyFromDate(dateStr)] || []).filter(item => item.entry_date === dateStr);
}

function renderOwnerSidebar() {
  const sidebar = document.getElementById("ownerSidebar");
  if (!sidebar) return;
  sidebar.classList.toggle("hidden", !canUseOwnerEditControls() || currentView !== "home");
  if (!canUseOwnerEditControls() || currentView !== "home") return;

  const dateStr = document.getElementById("entryDate").value;
  const monthKey = monthKeyFromDate(dateStr);
  const dayEntries = (allData[monthKey] || {})[dateStr] || {};
  const userDayEntries = (allUserData[monthKey] || {})[dateStr] || {};
  const leave = (allLeaves[monthKey] || {})[dateStr];
  const summary = computeDaySummary(dayEntries);
  const userSummary = computeUserDaySummary(userDayEntries);
  const unitTotals = computeCalendarUnitTotals(dayEntries, userDayEntries);

  document.getElementById("sidebarDate").value = dateStr;
  document.getElementById("sidebarDaySummary").innerHTML = `
    <div class="calendar-summary">${escapeHTML(dateStr)}</div>
    <strong>${escapeHTML(calendarUnitSummaryText(unitTotals))}</strong>
    <span class="readonly-note">${summary.logged} team${summary.logged !== 1 ? "s" : ""}, ${userSummary.logged} user${userSummary.logged !== 1 ? "s" : ""} logged</span>
  `;

  document.getElementById("sidebarEntryControls").innerHTML = [
    ...TEAMS.map(t => `
    <div class="sidebar-entry-item">
      <strong>${escapeHTML(t.name)}</strong>
      <span class="readonly-note">Current: ${formatTeamValue(teamTotalForDate(t, dateStr), t)}</span>
      <div class="sidebar-entry-actions">
        <input type="number" min="0" step="any" id="sidebar_add_${t.id}" value="0" placeholder="Add ${escapeHTML(teamUnitLabel(t))}">
        <button data-sidebar-add="${t.id}">Add</button>
        <input type="number" min="0" step="any" id="sidebar_revoke_${t.id}" value="0" placeholder="Revoke ${escapeHTML(teamUnitLabel(t))}">
        <button class="danger" data-sidebar-revoke="${t.id}">Revoke</button>
      </div>
    </div>
    `),
    ...listEntryUsers().map(u => `
    <div class="sidebar-entry-item">
      <strong>${escapeHTML(u.name)}</strong>
      <span class="readonly-note">Current: ${formatUserValue(userDayEntries[u.id] || 0, u)}</span>
      <div class="sidebar-entry-actions">
        <input type="number" min="0" step="any" id="sidebar_user_add_${u.id}" value="0" placeholder="Add ${escapeHTML(userUnitLabel(u))}">
        <button data-sidebar-user-add="${u.id}">Add</button>
        <input type="number" min="0" step="any" id="sidebar_user_revoke_${u.id}" value="0" placeholder="Revoke ${escapeHTML(userUnitLabel(u))}">
        <button class="danger" data-sidebar-user-revoke="${u.id}">Revoke</button>
      </div>
    </div>
    `)
  ].join("");

  document.getElementById("sidebarLeaveControls").innerHTML = `
    <label for="leaveNote">Leave marker</label>
    <input type="text" id="leaveNote" value="${escapeHTML(leave ? (leave.note || "") : "")}" placeholder="Leave note">
    <button id="markLeaveBtn">${leave ? "Update leave" : "Mark leave"}</button>
    ${leave ? `<button class="danger" id="clearLeaveBtn">Clear leave</button>` : ""}
  `;

  document.querySelectorAll("[data-sidebar-add]").forEach(btn => {
    btn.addEventListener("click", () => handleSidebarAdd(btn.dataset.sidebarAdd));
  });
  document.querySelectorAll("[data-sidebar-revoke]").forEach(btn => {
    btn.addEventListener("click", () => handleSidebarRevoke(btn.dataset.sidebarRevoke));
  });
  document.querySelectorAll("[data-sidebar-user-add]").forEach(btn => {
    btn.addEventListener("click", () => handleSidebarUserAdd(btn.dataset.sidebarUserAdd));
  });
  document.querySelectorAll("[data-sidebar-user-revoke]").forEach(btn => {
    btn.addEventListener("click", () => handleSidebarUserRevoke(btn.dataset.sidebarUserRevoke));
  });
  document.getElementById("markLeaveBtn").addEventListener("click", () => saveLeaveForDate(true));
  const clearBtn = document.getElementById("clearLeaveBtn");
  if (clearBtn) clearBtn.addEventListener("click", () => saveLeaveForDate(false));
}

function openDayPopup(dateStr) {
  const monthKey = monthKeyFromDate(dateStr);
  const dayEntries = (allData[monthKey] || {})[dateStr] || {};
  const userDayEntries = (allUserData[monthKey] || {})[dateStr] || {};
  const leave = (allLeaves[monthKey] || {})[dateStr];
  const logs = dayAdjustments(dateStr);
  const userLogs = userDayAdjustments(dateStr);
  const summary = computeDaySummary(dayEntries);
  const userSummary = computeUserDaySummary(userDayEntries);
  const modal = document.getElementById("dayModal");

  document.getElementById("modalDateTitle").textContent = dateStr;
  document.getElementById("modalDateSummary").textContent = calendarUnitSummaryText(computeCalendarUnitTotals(dayEntries, userDayEntries));

  const teamRows = TEAMS.map(t => `
    <div class="detail-row">
      <div>${escapeHTML(t.name)}</div>
      <strong>${formatTeamValue(teamTotalForDate(t, dateStr), t)}</strong>
    </div>
  `).join("");
  const userRows = ENTRY_USERS.map(u => `
    <div class="detail-row">
      <div>${escapeHTML(u.name)}</div>
      <strong>${formatUserValue(userDayEntries[u.id] || 0, u)}</strong>
    </div>
  `).join("");
  const logRows = logs.length ? logs.map(item => {
    const sign = item.action === "revoke" ? "-" : "+";
    const team = TEAMS.find(t => t.id === item.team_id);
    return `
      <div class="detail-row">
        <div><strong>${escapeHTML(item.user_name || "Unknown")}</strong><span> ${escapeHTML(teamName(item.team_id))} ${escapeHTML(item.action)}</span></div>
        <strong>${sign}${team ? formatTeamValue(item.amount, team) : formatMetricValue(item.amount, item.metric_type || "revenue", item.currency || "USD")}</strong>
      </div>
    `;
  }).join("") : `<div class="empty-note">No adjustment log for this day.</div>`;
  const userLogRows = userLogs.length ? userLogs.map(item => {
    const sign = item.action === "revoke" ? "-" : "+";
    const entryUser = ENTRY_USERS.find(u => Number(u.id) === Number(item.entry_user_id));
    return `
      <div class="detail-row">
        <div><strong>${escapeHTML(item.actor_name || "Unknown")}</strong><span> ${escapeHTML(item.entry_user_name || entryUserName(item.entry_user_id))} ${escapeHTML(item.action)}</span></div>
        <strong>${sign}${entryUser ? formatUserValue(item.amount, entryUser) : formatUnitValue(item.amount, "leads")}</strong>
      </div>
    `;
  }).join("") : `<div class="empty-note">No user log for this day.</div>`;

  document.getElementById("modalDayDetails").innerHTML = `
    ${leave ? `<div class="detail-row" style="border-color:var(--red);"><div class="leave-marker">! Leave marker</div><strong>${escapeHTML(leave.note || "Leave")}</strong></div>` : ""}
    <div class="section-title">Team performance</div>
    <div class="detail-list">${teamRows}</div>
    <div class="section-title">User performance</div>
    <div class="detail-list">${userRows || `<div class="empty-note">No user rows.</div>`}</div>
    <div class="section-title">Entry log</div>
    <div class="detail-list">${logRows}</div>
    <div class="section-title">User log</div>
    <div class="detail-list">${userLogRows}</div>
  `;
  modal.classList.remove("hidden");
}

function closeDayPopup() {
  document.getElementById("dayModal").classList.add("hidden");
}

function renderLog() {
  const monthKey = document.getElementById("monthSelect").value;
  const monthObj = allData[monthKey] || {};
  const userMonthObj = allUserData[monthKey] || {};
  const adjustments = allAdjustments[monthKey] || [];
  const userAdjustments = allUserAdjustments[monthKey] || [];
  const container = document.getElementById("logContainer");
  const dates = Array.from(new Set([
    ...Object.keys(monthObj),
    ...Object.keys(userMonthObj),
    ...adjustments.map(item => item.entry_date),
    ...userAdjustments.map(item => item.entry_date)
  ])).sort().reverse();

  if (dates.length === 0) {
    container.innerHTML = `<div class="empty-note">No entries yet.</div>`;
    return;
  }

  container.innerHTML = "";
  dates.forEach(dateStr => {
    const entries = monthObj[dateStr] || {};
    const userEntries = userMonthObj[dateStr] || {};
    const teamSnapshotItems = TEAMS
      .filter(t => typeof entries[t.id] === "number")
      .map(t => ({
        kind: "snapshot",
        actionLabel: "Saved total",
        actor: "Team entry",
        subject: t.name,
        subjectType: "Team",
        metric: t.metric_type || "revenue",
        amount: formatTeamValue(entries[t.id], t)
      }));
    const userSnapshotItems = ENTRY_USERS
      .filter(u => typeof userEntries[u.id] === "number")
      .map(u => ({
        kind: "snapshot",
        actionLabel: "Saved total",
        actor: u.name,
        subject: u.name,
        subjectType: "User",
        metric: u.metric_type || "leads",
        team: (u.team_ids || []).map(teamName).filter(Boolean).join(", ") || "No team",
        amount: formatUserValue(userEntries[u.id], u)
      }));
    const dayAdjustments = adjustments.filter(item => item.entry_date === dateStr);
    const dayUserAdjustments = userAdjustments.filter(item => item.entry_date === dateStr);
    const teamLogItems = dayAdjustments.map(item => {
      const sign = item.action === "revoke" ? "-" : "+";
      const team = TEAMS.find(t => t.id === item.team_id);
      const amount = team ? formatTeamValue(item.amount, team) : formatMetricValue(item.amount, item.metric_type || "revenue", item.currency || "USD");
      return {
        kind: item.action || "add",
        actionLabel: item.action === "revoke" ? "Revoked" : "Added",
        actor: item.user_name || "Unknown",
        subject: teamName(item.team_id),
        subjectType: "Team",
        metric: item.metric_type || (team ? team.metric_type : "revenue"),
        amount: `${sign}${amount}`,
        createdAt: item.created_at || "",
        note: item.note || ""
      };
    });
    const userLogItems = dayUserAdjustments.map(item => {
      const sign = item.action === "revoke" ? "-" : "+";
      const entryUser = ENTRY_USERS.find(u => Number(u.id) === Number(item.entry_user_id));
      const amount = entryUser ? formatUserValue(item.amount, entryUser) : formatUnitValue(item.amount, "leads");
      return {
        kind: item.action || "add",
        actionLabel: item.action === "revoke" ? "Revoked" : "Added",
        actor: item.actor_name || "Unknown",
        subject: item.entry_user_name || entryUserName(item.entry_user_id),
        subjectType: "User",
        metric: entryUser ? entryUser.metric_type : "leads",
        team: entryUser ? (entryUser.team_ids || []).map(teamName).filter(Boolean).join(", ") || "No team" : "No team",
        amount: `${sign}${amount}`,
        createdAt: item.created_at || "",
        note: item.note || ""
      };
    });
    const logItems = [
      ...teamLogItems,
      ...userLogItems,
      ...teamSnapshotItems,
      ...userSnapshotItems
    ];
    const preview = logItems.slice(0, 3)
      .map(item => `${item.actor} -> ${item.subject}: ${item.amount}`)
      .join(" | ");
    const extraCount = logItems.length > 3 ? ` +${logItems.length - 3} more` : "";

    const header = document.createElement("div");
    header.className = "day-header";
    header.innerHTML = `
      <div class="day-header-main">
        <span class="day-header-date">${escapeHTML(dateStr)}</span>
        <span class="day-header-preview">${escapeHTML(preview || "No data")}${escapeHTML(extraCount)}</span>
      </div>
      <span class="day-header-count">${logItems.length} detail${logItems.length !== 1 ? "s" : ""}</span>
    `;

    const bodyDiv = document.createElement("div");
    bodyDiv.className = "day-body";
    if (openLogDate === dateStr) bodyDiv.classList.add("open");
    bodyDiv.innerHTML = logItems.length ? `
      <div class="log-grid">
        ${logItems.map(item => `
          <div class="log-item ${escapeHTML(item.kind)}">
            <div class="log-line"><span>User name</span><strong>${escapeHTML(item.actor)}</strong></div>
            <div class="log-line"><span>${escapeHTML(item.subjectType)}</span><strong>${escapeHTML(item.subject)}</strong></div>
            ${item.team ? `<div class="log-line"><span>Team</span><strong>${escapeHTML(item.team)}</strong></div>` : ""}
            <div class="log-line"><span>Metric</span><strong>${escapeHTML((item.metric || "").toUpperCase())}</strong></div>
            <div class="log-line"><span>Action</span><strong>${escapeHTML(item.actionLabel)}</strong></div>
            <div class="log-line"><span>Count / amount</span><strong>${escapeHTML(item.amount)}</strong></div>
            ${item.createdAt ? `<div class="log-line"><span>Logged at</span><strong>${escapeHTML(item.createdAt)}</strong></div>` : ""}
            ${item.note ? `<div class="log-line"><span>Note</span><strong>${escapeHTML(item.note)}</strong></div>` : ""}
          </div>
        `).join("")}
      </div>
    ` : `<div class="empty-note">No data</div>`;

    header.addEventListener("click", () => {
      openLogDate = openLogDate === dateStr ? null : dateStr;
      document.getElementById("entryDate").value = dateStr;
      loadEntryFieldsForDate();
      renderAll();
    });

    container.appendChild(header);
    container.appendChild(bodyDiv);
  });
}

function renderAll() {
  buildDashboardFilters();
  renderCards();
  renderCalendar();
  renderOwnerSidebar();
  renderLog();
  refreshDateDisplays();
}

function loadEntryFieldsForDate() {
  const dateStr = document.getElementById("entryDate").value;
  const monthKey = monthKeyFromDate(dateStr);
  const monthObj = allData[monthKey] || {};
  const dayEntries = monthObj[dateStr] || {};
  const userMonthObj = allUserData[monthKey] || {};
  const userDayEntries = userMonthObj[dateStr] || {};
  TEAMS.forEach(t => {
    const canUpdate = canUpdateTeam(t.id);
    const input = document.getElementById(`entry_team_${t.id}`);
    const revokeInput = document.getElementById(`revoke_team_${t.id}`);
    const current = document.getElementById(`entry_current_team_${t.id}`);
    if (current) current.textContent = formatTeamValue(teamTotalForDate(t, dateStr), t);
    if (input) {
      input.value = "0";
      input.disabled = !canUpdate;
    }
    if (revokeInput) {
      revokeInput.value = "0";
      revokeInput.disabled = !canUpdate;
    }
  });
  ENTRY_USERS.forEach(u => {
    const canUpdate = canUpdateEntryUser(u.id);
    const input = document.getElementById(`entry_user_${u.id}`);
    const revokeInput = document.getElementById(`revoke_user_${u.id}`);
    const current = document.getElementById(`entry_current_user_${u.id}`);
    if (current) current.textContent = formatUserValue(userDayEntries[u.id] || 0, u);
    if (input) {
      input.value = "0";
      input.disabled = !canUpdate;
    }
    if (revokeInput) {
      revokeInput.value = "0";
      revokeInput.disabled = !canUpdate;
    }
  });
}

function readTeamValues(prefix) {
  const values = [];
  TEAMS.forEach(t => {
    if (!canUpdateTeam(t.id)) return;
    const input = document.getElementById(`${prefix}${t.id}`);
    if (input && input.value !== "" && input.value !== null) {
      const amount = parseFloat(input.value);
      if (amount > 0) values.push({ team: t, amount });
    }
  });
  return values;
}

function readUserValues(prefix) {
  const values = [];
  ENTRY_USERS.forEach(u => {
    if (!canUpdateEntryUser(u.id)) return;
    const input = document.getElementById(`${prefix}${u.id}`);
    if (input && input.value !== "" && input.value !== null) {
      const amount = parseFloat(input.value);
      if (amount > 0) values.push({ user: u, amount });
    }
  });
  return values;
}

async function addValues(dateStr, values) {
  if (!dateStr) {
    alert("Pick a date first.");
    return;
  }
  if (values.length === 0 || values.some(item => !isFinite(item.amount) || item.amount <= 0)) {
    alert("Enter at least one amount greater than 0.");
    return;
  }
  if (values.some(item => !canUpdateTeam(item.team.id))) {
    alert("You are not assigned to one of these teams.");
    return;
  }

  const monthKey = monthKeyFromDate(dateStr);
  await Promise.all(values.map(item => saveTeamEntry(item.team.id, dateStr, item.amount)));
  await loadMonthData(monthKey);
  loadEntryFieldsForDate();
  renderAll();
  showStatus();
}

async function addUserValues(dateStr, values) {
  if (!dateStr) {
    alert("Pick a date first.");
    return;
  }
  if (values.length === 0 || values.some(item => !isFinite(item.amount) || item.amount <= 0)) {
    alert("Enter at least one amount greater than 0.");
    return;
  }
  if (values.some(item => !canUpdateEntryUser(item.user.id))) {
    alert("You can only update your own daily entry.");
    return;
  }

  const monthKey = monthKeyFromDate(dateStr);
  await Promise.all(values.map(item => saveUserEntry(item.user.id, dateStr, item.amount)));
  await loadMonthData(monthKey);
  loadEntryFieldsForDate();
  renderAll();
  showStatus();
}

async function revokeValues(dateStr, values) {
  if (!dateStr) {
    alert("Pick a date first.");
    return;
  }
  if (values.length === 0 || values.some(item => !isFinite(item.amount) || item.amount <= 0)) {
    alert("Enter at least one revoke amount greater than 0.");
    return;
  }
  if (values.some(item => !canUpdateTeam(item.team.id))) {
    alert("You are not assigned to one of these teams.");
    return;
  }

  const monthKey = monthKeyFromDate(dateStr);
  await Promise.all(values.map(item => revokeTeamEntry(item.team.id, dateStr, item.amount)));
  await loadMonthData(monthKey);
  loadEntryFieldsForDate();
  renderAll();
  showStatus();
}

async function revokeUserValues(dateStr, values) {
  if (!dateStr) {
    alert("Pick a date first.");
    return;
  }
  if (values.length === 0 || values.some(item => !isFinite(item.amount) || item.amount <= 0)) {
    alert("Enter at least one revoke amount greater than 0.");
    return;
  }
  if (values.some(item => !canUpdateEntryUser(item.user.id))) {
    alert("You can only update your own daily entry.");
    return;
  }

  const monthKey = monthKeyFromDate(dateStr);
  await Promise.all(values.map(item => revokeUserEntry(item.user.id, dateStr, item.amount)));
  await loadMonthData(monthKey);
  loadEntryFieldsForDate();
  renderAll();
  showStatus();
}

async function handleSave() {
  try {
    const dateStr = document.getElementById("entryDate").value;
    const teamValues = readTeamValues("entry_team_");
    const userValues = readUserValues("entry_user_");
    if (teamValues.length === 0 && userValues.length === 0) {
      alert("Enter at least one amount greater than 0.");
      return;
    }
    const monthKey = monthKeyFromDate(dateStr);
    await Promise.all([
      ...teamValues.map(item => saveTeamEntry(item.team.id, dateStr, item.amount)),
      ...userValues.map(item => saveUserEntry(item.user.id, dateStr, item.amount))
    ]);
    await loadMonthData(monthKey);
    loadEntryFieldsForDate();
    renderAll();
    showStatus();
  } catch (e) {
    alert(e.message || "Something went wrong saving.");
    console.error(e);
  }
}

async function handleCardAdd(teamId) {
  const team = TEAMS.find(t => t.id === teamId);
  const input = document.getElementById(`card_add_${teamId}`);
  if (!team || !input) return;
  try {
    await addValues(document.getElementById("entryDate").value, [{ team, amount: parseFloat(input.value) }]);
  } catch (e) {
    alert(e.message || "Something went wrong saving.");
    console.error(e);
  }
}

