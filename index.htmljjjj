async function saveLeaveForDate(isLeave) {
  const dateStr = document.getElementById("entryDate").value;
  const noteInput = document.getElementById("leaveNote");
  if (!dateStr) {
    alert("Pick a date first.");
    return;
  }
  try {
    await apiRequest("leave_save", {
      method: "POST",
      body: { date: dateStr, is_leave: isLeave, note: noteInput ? noteInput.value : "" }
    });
    await loadMonthData(monthKeyFromDate(dateStr));
    renderAll();
    showStatus();
  } catch (e) {
    alert(e.message || "Leave marker could not be saved.");
    console.error(e);
  }
}

